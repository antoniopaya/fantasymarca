---
import Layout from "../../layouts/Layout.astro";
import JugadoresTabs from "../../components/JugadoresTabs.astro";
import DifficultyChip from "../../components/DifficultyChip.astro";
import ProbPill from "../../components/ProbPill.astro";
import {
  getAllPlayerSummaries,
  getLineupsScrapedAt,
  getNextGameweek,
  getPredictions,
  playerPhotoUrl,
  POSITION_NAMES,
  POSITION_SHORT,
  url,
  type PlayerSummary,
} from "../../lib/data";
import {
  difficulty,
  expectedPoints,
  expectedPointsHorizon,
  fixtureIn,
  horizonGameweeks,
  prediction,
  teamFixtures,
} from "../../lib/forecast";
import { bestEleven, latestOwnershipPct } from "../../lib/liga";

const gw = getNextGameweek();
const preds = getPredictions();
const usingModel = preds?.jornada === gw.number;
const scrapedAt = getLineupsScrapedAt();

interface Rec {
  s: PlayerSummary;
  xp: number;
  rival: string | null;
  home: boolean | null;
  diff: number | null;
  prob: number | null;
  owned: number;
  xp3: number;
  perGw: {
    gw: number;
    xp: number;
    rival: string | null;
    diff: number | null;
  }[];
}

const horizon = horizonGameweeks();

const recs: Rec[] = getAllPlayerSummaries()
  .filter((s) => s.precioFantastica !== null)
  .map((s) => {
    const f = fixtureIn(s.id_team, gw.number);
    return {
      s,
      xp: expectedPoints(s, gw.number),
      rival: f?.rivalName ?? null,
      home: f?.home ?? null,
      diff: f ? difficulty(f.rivalId, s.position, f.home) : null,
      prob: prediction(s.id, gw.number)?.ff_prob ?? null,
      owned: latestOwnershipPct(s.id),
      ...(() => {
        const h = expectedPointsHorizon(s);
        const fixtures = teamFixtures(s.id_team);
        return {
          xp3: h.total,
          perGw: h.perGw.map((x) => {
            const fx = fixtures.find((f) => f.gameweek === x.gw);
            return {
              ...x,
              rival: fx?.rivalName ?? null,
              diff: fx ? difficulty(fx.rivalId, s.position, fx.home) : null,
            };
          }),
        };
      })(),
    };
  })
  .filter((r) => r.rival !== null);

const byXp = [...recs].sort((a, b) => b.xp - a.xp);
const byPosition = [1, 2, 3, 4].map((pos) => ({
  pos,
  list: byXp.filter((r) => r.s.position === pos).slice(0, 6),
}));
const millions = (r: Rec) => (r.s.precioFantastica ?? 0) / 1_000_000;
const value = [...recs]
  .filter((r) => r.xp >= 3)
  .sort((a, b) => b.xp / millions(b) - a.xp / millions(a))
  .slice(0, 10);
const differentials = byXp.filter((r) => r.owned <= 10).slice(0, 10);
const byXp3 = [...recs].sort((a, b) => b.xp3 - a.xp3);
const next3 = [1, 2, 3, 4].map((pos) => ({
  pos,
  list: byXp3.filter((r) => r.s.position === pos).slice(0, 5),
}));

const xpById = new Map(recs.map((r) => [r.s.id, r.xp]));
const eleven = bestEleven(
  gw.number,
  (s) => xpById.get(s.id) ?? 0,
  (s) => xpById.has(s.id),
);
const elevenXp = eleven
  ? eleven.players.reduce((sum, p) => sum + p.points * (p.captain ? 2 : 1), 0)
  : 0;

const fmt = (n: number) => n.toFixed(1).replace(".", ",");
const fmtM = (n: number) => `${fmt(n).replace(",0", "")}M`;
const fmtDate = (d: Date) =>
  new Intl.DateTimeFormat("es-ES", {
    timeZone: "Europe/Madrid",
    weekday: "short",
    day: "numeric",
    month: "short",
    hour: "2-digit",
    minute: "2-digit",
  }).format(d);
const summary = preds?.validation_summary;
const chosen = preds ? summary?.[preds.model] : undefined;
const baseline = summary?.media_previa;
---

<Layout
  title="Recomendados"
  description={`Jugadores recomendados para la ${gw.name} según el modelo de puntos esperados.`}
>
  <h1 class="mb-4 text-3xl font-black text-white">Jugadores</h1>
  <JugadoresTabs active="recomendados" />

  <section
    class="mb-8 rounded-2xl border border-white/10 bg-slate-900/60 p-4 text-sm text-slate-300"
  >
    <h2 class="text-lg font-bold text-white">
      Recomendados para la {gw.name}
    </h2>
    {
      usingModel && preds ? (
        <p class="mt-1">
          Puntos esperados de un modelo de machine learning ({preds.model},
          entrenado con {preds.n_train} partidos de jugador de las{" "}
          {preds.train_gameweeks} jornadas jugadas): probabilidad de jugar ×
          puntos si juega, según forma, titularidades, rival, casa/fuera, precio
          y temporada pasada
          {preds.lineups_jornada === gw.number &&
            ", con las alineaciones probables de futbolfantasy"}
          .
        </p>
      ) : (
        <p class="mt-1">
          Todavía no hay predicción del modelo para esta jornada: se usa la
          fórmula sencilla (media y forma ajustadas por rival).
        </p>
      )
    }
    {
      chosen && baseline && (
        <p class="mt-2 text-slate-400">
          Fiabilidad, prediciendo cada jornada pasada solo con las anteriores:
          los 50 jugadores que el modelo ponía arriba sacaron de media{" "}
          <b class="text-white">{fmt(chosen.top50)} pts</b> reales (frente a{" "}
          {fmt(baseline.top50)} eligiendo por media de puntos), con un error
          medio de {fmt(chosen.mae)} pts por jugador. Con pocas jornadas es una
          ayuda para ordenar opciones, no una bola de cristal.
        </p>
      )
    }
    {
      scrapedAt && (
        <p class="mt-2 text-xs text-slate-500">
          Alineaciones probables (futbolfantasy.com): {fmtDate(scrapedAt)}
        </p>
      )
    }
  </section>

  {
    eleven && (
      <section class="mb-10" aria-labelledby="once-modelo">
        <h2 id="once-modelo" class="text-xl font-bold text-white">
          El 11 del modelo
        </h2>
        <p class="mb-4 text-sm text-slate-400">
          Máximos puntos esperados con 180M ({eleven.formationKey},{" "}
          {fmtM(eleven.cost / 1_000_000)}): ≈{fmt(elevenXp)} pts con el capitán
          doblado.
        </p>
        <div class="space-y-3 rounded-2xl border border-white/10 bg-gradient-to-b from-emerald-950/40 to-slate-900/60 px-2 py-4">
          {[1, 2, 3, 4].map((pos) => (
            <div class="flex justify-center gap-1.5">
              {eleven.players
                .filter((p) => p.summary.position === pos)
                .map((p) => (
                  <a
                    href={url(`/jugadores/${p.summary.id}`)}
                    class="relative flex w-[calc((100%-1.5rem)/5)] max-w-[5.75rem] flex-col items-center rounded-2xl border border-white/10 bg-slate-900/90 px-0.5 pt-2 pb-1.5 text-center"
                  >
                    {p.captain && (
                      <span class="absolute top-1 left-1 flex h-5 w-5 items-center justify-center rounded-full bg-amber-400 text-[11px] font-black text-slate-950">
                        C
                      </span>
                    )}
                    <img
                      src={playerPhotoUrl(p.summary.id)}
                      alt=""
                      class="h-11 w-11 rounded-full bg-slate-800 object-cover"
                      loading="lazy"
                    />
                    <span class="mt-1 block w-full truncate text-xs font-semibold text-white">
                      {p.summary.name.split(" ").slice(-1)[0]}
                    </span>
                    <span class="text-[11px] text-slate-400">
                      {fmtM((p.summary.precioFantastica ?? 0) / 1_000_000)}
                    </span>
                    <span class="text-[11px] font-semibold text-emerald-300">
                      ≈{fmt(p.points * (p.captain ? 2 : 1))}
                    </span>
                  </a>
                ))}
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="mb-10" aria-labelledby="proximas-3">
    <h2 id="proximas-3" class="text-xl font-bold text-white">
      Para las próximas {horizon.length} jornadas
    </h2>
    <p class="mb-4 text-sm text-slate-400">
      Con los cambios contados, conviene fichar pensando en más de una semana:
      puntos esperados en cada jornada (J{horizon.join(", J")}) y su suma. Más
      allá de la próxima no hay alineaciones probables, así que cuenta solo lo
      que dice el modelo.
    </p>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        next3.map(({ pos, list }) => (
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4">
            <h3 class="mb-1 text-sm font-semibold text-white">
              {POSITION_NAMES[pos]}s
            </h3>
            <ol class="divide-y divide-white/5">
              {list.map((r) => (
                <li class="py-2">
                  <a
                    href={url(`/jugadores/${r.s.id}`)}
                    class="flex items-baseline justify-between gap-2"
                  >
                    <span class="min-w-0 truncate font-semibold text-white">
                      {r.s.name}
                      <span class="ml-1 text-xs font-normal text-slate-500">
                        {fmtM(millions(r))}
                      </span>
                    </span>
                    <span class="shrink-0 font-bold text-emerald-300">
                      ≈{fmt(r.xp3)}
                    </span>
                  </a>
                  <div class="mt-1 grid grid-cols-3 gap-1 text-xs text-slate-300">
                    {r.perGw.map((x) => (
                      <span
                        class="flex items-center gap-1"
                        title={x.rival ? `vs ${x.rival}` : "Sin partido"}
                      >
                        <span class="text-slate-500">J{x.gw}</span>
                        <DifficultyChip level={x.diff} />
                        {x.rival ? fmt(x.xp) : "—"}
                      </span>
                    ))}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mb-10" aria-labelledby="por-posicion">
    <h2 id="por-posicion" class="mb-4 text-xl font-bold text-white">
      Los mejores para la {gw.name}
    </h2>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        byPosition.map(({ pos, list }) => (
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4">
            <h3 class="mb-2 text-sm font-semibold text-white">
              {POSITION_NAMES[pos]}s
            </h3>
            <ol class="space-y-2">
              {list.map((r) => (
                <li>
                  <a
                    href={url(`/jugadores/${r.s.id}`)}
                    class="flex items-center gap-3 rounded-xl p-1 hover:bg-white/5"
                  >
                    <img
                      src={playerPhotoUrl(r.s.id)}
                      alt=""
                      class="h-10 w-10 shrink-0 rounded-full bg-slate-800 object-cover"
                      loading="lazy"
                    />
                    <span class="min-w-0 flex-1">
                      <span class="block truncate font-semibold text-white">
                        {r.s.name}
                      </span>
                      <span class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400">
                        vs {r.rival} ({r.home ? "c" : "f"})
                        <DifficultyChip level={r.diff} />
                        <ProbPill prob={r.prob} />
                        <span>{fmtM(millions(r))}</span>
                      </span>
                    </span>
                    <span class="shrink-0 text-right">
                      <span class="block font-bold text-emerald-300">
                        ≈{fmt(r.xp)}
                      </span>
                      <span class="block text-[10px] text-slate-500">
                        3 jornadas ≈{fmt(r.xp3)}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>

  <section class="grid grid-cols-1 gap-8 lg:grid-cols-2">
    <div>
      <h2 class="text-xl font-bold text-white">Más puntos por millón</h2>
      <p class="mb-4 text-sm text-slate-400">
        Para cuadrar el presupuesto: los que más se espera que sumen por cada
        millón (con al menos 3 pts esperados).
      </p>
      <ol class="space-y-1.5">
        {
          value.map((r) => (
            <li>
              <a
                href={url(`/jugadores/${r.s.id}`)}
                class="flex items-center gap-2 rounded-xl border border-white/10 bg-slate-900/60 px-3 py-2 text-sm hover:border-emerald-500/30"
              >
                <span class="w-9 shrink-0 text-[11px] font-semibold text-slate-500">
                  {POSITION_SHORT[r.s.position]}
                </span>
                <span class="min-w-0 flex-1 truncate text-white">
                  {r.s.name}
                </span>
                <ProbPill prob={r.prob} />
                <span class="shrink-0 text-slate-400">{fmtM(millions(r))}</span>
                <span class="w-12 shrink-0 text-right font-semibold text-emerald-300">
                  ≈{fmt(r.xp)}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
    <div>
      <h2 class="text-xl font-bold text-white">Diferenciales</h2>
      <p class="mb-4 text-sm text-slate-400">
        Muchos puntos esperados y en el 10% o menos de los equipos de la liga:
        si salen bien, recortas a casi todos.
      </p>
      <ol class="space-y-1.5">
        {
          differentials.map((r) => (
            <li>
              <a
                href={url(`/jugadores/${r.s.id}`)}
                class="flex items-center gap-2 rounded-xl border border-white/10 bg-slate-900/60 px-3 py-2 text-sm hover:border-emerald-500/30"
              >
                <span class="w-9 shrink-0 text-[11px] font-semibold text-slate-500">
                  {POSITION_SHORT[r.s.position]}
                </span>
                <span class="min-w-0 flex-1 truncate text-white">
                  {r.s.name}
                </span>
                <span class="shrink-0 text-xs text-slate-500">
                  {Math.round(r.owned)}% liga
                </span>
                <span class="shrink-0 text-slate-400">{fmtM(millions(r))}</span>
                <span class="w-12 shrink-0 text-right font-semibold text-emerald-300">
                  ≈{fmt(r.xp)}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>
