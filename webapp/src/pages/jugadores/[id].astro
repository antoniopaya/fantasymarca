---
import Layout from "../../layouts/Layout.astro";
import LineChart from "../../components/charts/LineChart.astro";
import {
  getPlayers,
  getPlayerById,
  getPlayerDetail,
  getPrecioFantastica,
  formatMoney,
  POSITION_NAMES,
  teamLogoUrl,
  url,
} from "../../lib/data";

export function getStaticPaths() {
  return getPlayers().map((p) => ({ params: { id: String(p.id) } }));
}

const { id } = Astro.params;
const playerId = Number(id);
const catalogEntry = getPlayerById(playerId)!;

let detail: ReturnType<typeof getPlayerDetail> | null = null;
let loadError: string | null = null;
try {
  detail = getPlayerDetail(playerId);
} catch (err) {
  loadError = err instanceof Error ? err.message : String(err);
}

const player = detail?.player;
const extra = detail?.player_extra;
const upcoming = detail?.points.slice(0, 6) ?? [];

const valueDiff = player ? player.value - player.previousValue : 0;

const precioFantastica = getPrecioFantastica(playerId);
const vsFantastica = player && precioFantastica ? player.value - precioFantastica : 0;
const vsFantasticaPct = precioFantastica ? (vsFantastica / precioFantastica) * 100 : 0;
---

<Layout title={catalogEntry.name} description={`Estadísticas y valor de mercado de ${catalogEntry.name}`}>
  <a href={url("/jugadores")} class="mb-6 inline-flex items-center gap-1 text-sm font-medium text-slate-400 hover:text-emerald-400">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
    Volver a jugadores
  </a>

  {
    loadError ? (
      <p class="rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-sm text-rose-300">
        No se pudo cargar la ficha del jugador: {loadError}
      </p>
    ) : player ? (
      <div class="space-y-8">
        <section class="flex flex-col items-center gap-5 rounded-2xl border border-white/10 bg-slate-900/60 p-6 sm:flex-row sm:items-start">
          <div class="relative h-28 w-28 shrink-0 overflow-hidden rounded-2xl bg-slate-800">
            <img src={player.photoUrl} alt={player.name} class="h-full w-full object-cover" />
            <img
              src={teamLogoUrl(player.team.id)}
              alt={player.team.name}
              class="absolute -bottom-1.5 -right-1.5 h-8 w-8 rounded-full bg-slate-950 p-1 ring-2 ring-slate-700"
            />
          </div>

          <div class="flex-1 text-center sm:text-left">
            <div class="flex flex-wrap items-center justify-center gap-2 sm:justify-start">
              <h1 class="text-2xl font-black text-white">{player.name}</h1>
              <span class="rounded-md bg-emerald-500/15 px-2 py-1 text-xs font-semibold text-emerald-400">
                {POSITION_NAMES[player.position] ?? "?"}
              </span>
            </div>
            <p class="mt-1 text-slate-400">{player.team.name}</p>

            <div class="mt-4 flex flex-wrap justify-center gap-4 text-sm text-slate-400 sm:justify-start">
              <span class="flex items-center gap-1.5">
                <span>{player.bio.country.flag}</span>
                {player.bio.country.country}
              </span>
              <span>{player.bio.age} años</span>
              <span>{player.bio.height} cm</span>
              {player.status && <span class="text-rose-400">{player.status}</span>}
            </div>
          </div>
        </section>

        <section class="grid grid-cols-2 gap-4 sm:grid-cols-5">
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <p class="text-xs uppercase tracking-wide text-slate-500">Valor de mercado</p>
            <p class="mt-1 text-xl font-bold text-white">{formatMoney(player.value)}</p>
            {valueDiff !== 0 && (
              <p class={`mt-1 text-xs font-medium ${valueDiff > 0 ? "text-emerald-400" : "text-rose-400"}`}>
                {valueDiff > 0 ? "▲" : "▼"} {formatMoney(Math.abs(valueDiff))}
              </p>
            )}
          </div>
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <p class="text-xs uppercase tracking-wide text-slate-500">Precio Fantástica</p>
            {precioFantastica ? (
              <>
                <p class="mt-1 text-xl font-bold text-white">{formatMoney(precioFantastica)}</p>
                {vsFantastica !== 0 && (
                  <p
                    class={`mt-1 text-xs font-medium ${vsFantastica > 0 ? "text-emerald-400" : "text-rose-400"}`}
                    title="Diferencia entre el valor de mercado actual y este precio de consenso"
                  >
                    Mercado {vsFantastica > 0 ? "▲" : "▼"} {Math.abs(vsFantasticaPct).toFixed(0)}%
                  </p>
                )}
              </>
            ) : (
              <p class="mt-1 text-xl font-bold text-slate-500">—</p>
            )}
          </div>
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <p class="text-xs uppercase tracking-wide text-slate-500">Cláusula</p>
            <p class="mt-1 text-xl font-bold text-white">{formatMoney(player.clause.value)}</p>
            <p class="mt-1 text-xs text-slate-500">x{player.clause.multiplier}</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <p class="text-xs uppercase tracking-wide text-slate-500">Puntos</p>
            <p class="mt-1 text-xl font-bold text-white">{player.points}</p>
            <p class="mt-1 text-xs text-slate-500">Media {player.avg}</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <p class="text-xs uppercase tracking-wide text-slate-500">Ranking cláusulas</p>
            <p class="mt-1 text-xl font-bold text-white">#{player.clausesRanking}</p>
          </div>
        </section>

        {extra && (
          <section class="grid grid-cols-3 gap-4">
            <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5 text-center">
              <p class="text-2xl font-bold text-white">{extra.matches}</p>
              <p class="mt-1 text-xs text-slate-500">Partidos</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5 text-center">
              <p class="text-2xl font-bold text-white">{extra.goals}</p>
              <p class="mt-1 text-xs text-slate-500">Goles</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5 text-center">
              <p class="text-2xl font-bold text-white">{extra.cards}</p>
              <p class="mt-1 text-xs text-slate-500">Tarjetas</p>
            </div>
          </section>
        )}

        {detail?.values_chart && (
          <section class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <div class="mb-4 flex items-center justify-between">
              <h2 class="text-xl font-bold text-white">Evolución del valor</h2>
              <p class="text-xs text-slate-500">
                Máx {formatMoney(detail.values_chart.max.value)} ({detail.values_chart.max.date}) · Mín{" "}
                {formatMoney(detail.values_chart.min.value)} ({detail.values_chart.min.date})
              </p>
            </div>
            <LineChart points={detail.values_chart.points} />
          </section>
        )}

        <section>
          <h2 class="mb-4 text-xl font-bold text-white">Próximas jornadas</h2>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
            {upcoming.map((gw) => (
              <div class="flex flex-col items-center gap-2 rounded-xl border border-white/10 bg-slate-900/60 p-4 text-center">
                <span class="text-xs font-semibold text-slate-500">{gw.shortName}</span>
                <img src={gw.rivalLogoUrl} alt="rival" class="h-8 w-8 object-contain" />
                <span class="text-xs text-slate-500">
                  {new Date(gw.startDate).toLocaleDateString("es-ES", { day: "numeric", month: "short" })}
                </span>
                <span class="text-sm font-bold text-white">
                  {gw.points.points === null ? "—" : gw.points.points}
                </span>
              </div>
            ))}
          </div>
        </section>

        {detail && detail.points_history.length > 0 && (
          <section>
            <h2 class="mb-4 text-xl font-bold text-white">Temporadas anteriores</h2>
            <div class="overflow-x-auto rounded-xl border border-white/10">
              <table class="w-full min-w-[420px] text-sm">
                <thead>
                  <tr class="border-b border-white/10 bg-slate-900/80 text-left text-xs uppercase tracking-wide text-slate-500">
                    <th class="px-3 py-2">Temporada</th>
                    <th class="px-3 py-2">Puntos</th>
                    <th class="px-3 py-2">Media</th>
                    <th class="px-3 py-2">Última jornada</th>
                  </tr>
                </thead>
                <tbody>
                  {detail.points_history.map((season) => (
                    <tr class="border-b border-white/5">
                      <td class="px-3 py-2 font-medium text-white">{season.season}</td>
                      <td class="px-3 py-2 text-white">{season.points}</td>
                      <td class="px-3 py-2 text-slate-400">{season.avg.toFixed(2)}</td>
                      <td class="px-3 py-2 text-slate-400">J{season.last_gameweek}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}
      </div>
    ) : (
      <p class="rounded-xl border border-white/10 bg-slate-900/60 p-6 text-center text-slate-400">
        Sin datos disponibles.
      </p>
    )
  }
</Layout>
