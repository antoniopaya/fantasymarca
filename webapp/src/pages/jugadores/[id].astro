---
import Layout from "../../layouts/Layout.astro";
import LineChart from "../../components/charts/LineChart.astro";
import YoScript from "../../components/YoScript.astro";
import {
  getPlayers,
  getPlayerById,
  getPlayerDetail,
  getPrecioFantastica,
  getAllPlayerSummaries,
  getLigaJornadas,
  getNextGameweek,
  formatMoney,
  formatNumber,
  PLAYER_STATUS_LABELS,
  POSITION_NAMES,
  teamLogoUrl,
  url,
} from "../../lib/data";
import { FAMILIA_COLORS, ligaPlayerInfo } from "../../lib/liga";
import {
  DIFFICULTY_COLORS,
  DIFFICULTY_LABELS,
  expectedPoints,
  upcomingFor,
} from "../../lib/forecast";
import { FAMILIA } from "../../lib/yo";
import {
  STATS,
  activeStats,
  playerBreakdown,
  seasonStats,
  statLabel,
} from "../../lib/desglose";

export function getStaticPaths() {
  return getPlayers().map((p) => ({ params: { id: String(p.id) } }));
}

const { id } = Astro.params;
const playerId = Number(id);
const catalogEntry = getPlayerById(playerId)!;

let detail: ReturnType<typeof getPlayerDetail> | null = null;
let loadError: string | null = null;
try {
  detail = getPlayerDetail(playerId);
} catch (err) {
  loadError = err instanceof Error ? err.message : String(err);
}

const player = detail?.player;
const extra = detail?.player_extra;
const nextGwNumber = getNextGameweek().number;
const recent =
  detail?.points.filter((p) => p.number < nextGwNumber).slice(-6) ?? [];
const summary = getAllPlayerSummaries().find((s) => s.id === playerId);
const nextFixtures = summary ? upcomingFor(summary, 5) : [];
const nextXp = summary ? expectedPoints(summary) : null;

const valueDiff = player ? player.value - player.previousValue : 0;

// Desglose de puntos por estadística (fantasy_api/player_stats.py).
// La jornada más reciente primero: en el móvil es la que se ve sin deslizar.
const breakdown = playerBreakdown(playerId).reverse();
const breakdownStats = activeStats().filter((k) =>
  breakdown.some(([, g]) => g.c?.[k]?.[1]),
);
const statSeason = seasonStats().get(playerId);
const fmt1 = (x: number) => x.toFixed(1).replace(".", ",");
const fmt2 = (x: number) => x.toFixed(2).replace(".", ",");

const precioFantastica = getPrecioFantastica(playerId);

const ligaJornadas = getLigaJornadas();
const ligaLast = ligaJornadas.at(-1);
const ligaInfo = ligaPlayerInfo(playerId);
const ligaOwners = ligaInfo?.owners ?? [];
const ligaPerJornada = ligaJornadas.map((j) => ({
  jornada: j.number,
  pct: ligaInfo?.perJornada.find((p) => p.jornada === j.number)?.pct ?? 0,
}));
const vsFantastica =
  player && precioFantastica ? player.value - precioFantastica : 0;
const vsFantasticaPct = precioFantastica
  ? (vsFantastica / precioFantastica) * 100
  : 0;
---

<Layout
  title={catalogEntry.name}
  description={`Estadísticas y valor de mercado de ${catalogEntry.name}`}
>
  <a
    href={url("/jugadores")}
    data-back
    class="mb-6 inline-flex items-center gap-1 py-2 text-sm font-medium text-slate-400 hover:text-emerald-400"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-4 w-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"
      ></path>
    </svg>
    <span data-back-label>Volver a jugadores</span>
  </a>
  <script>
    // Si se llega desde otra página de la web (Mi 11, Inicio, Liga, una
    // búsqueda con filtros...), "Volver" regresa a ella en vez de a la lista.
    const back = document.querySelector<HTMLAnchorElement>("[data-back]");
    const ref = document.referrer ? new URL(document.referrer) : null;
    if (back && ref && ref.origin === location.origin && history.length > 1) {
      back.querySelector("[data-back-label]")!.textContent = "Volver";
      back.addEventListener("click", (e) => {
        e.preventDefault();
        history.back();
      });
    }
  </script>

  {
    loadError ? (
      <p class="rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-sm text-rose-300">
        No se pudo cargar la ficha del jugador: {loadError}
      </p>
    ) : player ? (
      <div class="space-y-8">
        <section class="flex flex-col items-center gap-5 rounded-2xl border border-white/10 bg-slate-900/60 p-6 sm:flex-row sm:items-start">
          <div class="relative h-28 w-28 shrink-0 overflow-hidden rounded-2xl bg-slate-800">
            <img
              src={player.photoUrl}
              alt={player.name}
              class="h-full w-full object-cover"
            />
            <img
              src={teamLogoUrl(player.team.id)}
              alt={player.team.name}
              class="absolute -right-1.5 -bottom-1.5 h-8 w-8 rounded-full bg-slate-950 p-1 ring-2 ring-slate-700"
            />
          </div>

          <div class="flex-1 text-center sm:text-left">
            <div class="flex flex-wrap items-center justify-center gap-2 sm:justify-start">
              <h1 class="text-2xl font-black text-white">{player.name}</h1>
              <span class="rounded-md bg-emerald-500/15 px-2 py-1 text-xs font-semibold text-emerald-400">
                {POSITION_NAMES[player.position] ?? "?"}
              </span>
            </div>
            <p class="mt-1 text-slate-400">{player.team.name}</p>

            <div class="mt-4 flex flex-wrap justify-center gap-4 text-sm text-slate-400 sm:justify-start">
              <span class="flex items-center gap-1.5">
                <span>{player.bio.country.flag}</span>
                {player.bio.country.country}
              </span>
              <span>{player.bio.age} años</span>
              <span>{player.bio.height} cm</span>
              {player.status && (
                <span class="text-rose-400">
                  {PLAYER_STATUS_LABELS[player.status] ?? "Baja"}
                </span>
              )}
            </div>

            {precioFantastica !== null && (
              <a
                href={url(`/crear-once?add=${player.id}`)}
                class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 shadow-lg shadow-emerald-500/20 transition-transform hover:-translate-y-0.5 hover:bg-emerald-400"
              >
                + Añadir a Mi 11
              </a>
            )}
          </div>
        </section>

        <section class="grid grid-cols-2 gap-4 sm:grid-cols-5">
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <p class="text-xs tracking-wide text-slate-500 uppercase">
              Valor de mercado
            </p>
            <p class="mt-1 text-xl font-bold text-white">
              {formatMoney(player.value)}
            </p>
            {valueDiff !== 0 && (
              <p
                class={`mt-1 text-xs font-medium ${valueDiff > 0 ? "text-emerald-400" : "text-rose-400"}`}
              >
                {valueDiff > 0 ? "▲" : "▼"} {formatMoney(Math.abs(valueDiff))}
              </p>
            )}
          </div>
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <p class="text-xs tracking-wide text-slate-500 uppercase">
              Precio Fantástica
            </p>
            {precioFantastica ? (
              <>
                <p class="mt-1 text-xl font-bold text-white">
                  {formatMoney(precioFantastica)}
                </p>
                {vsFantastica !== 0 && (
                  <p
                    class={`mt-1 text-xs font-medium ${vsFantastica > 0 ? "text-emerald-400" : "text-rose-400"}`}
                    title="Diferencia entre el valor de mercado actual y este precio de consenso"
                  >
                    Mercado {vsFantastica > 0 ? "▲" : "▼"}{" "}
                    {Math.abs(vsFantasticaPct).toFixed(0)}%
                  </p>
                )}
              </>
            ) : (
              <p class="mt-1 text-xl font-bold text-slate-500">—</p>
            )}
          </div>
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <p class="text-xs tracking-wide text-slate-500 uppercase">
              Cláusula
            </p>
            <p class="mt-1 text-xl font-bold text-white">
              {formatMoney(player.clause.value)}
            </p>
            <p class="mt-1 text-xs text-slate-500">
              x{player.clause.multiplier}
            </p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <p class="text-xs tracking-wide text-slate-500 uppercase">Puntos</p>
            <p class="mt-1 text-xl font-bold text-white">{player.points}</p>
            <p class="mt-1 text-xs text-slate-500">
              Media {formatNumber(player.avg, 1)}
            </p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <p class="text-xs tracking-wide text-slate-500 uppercase">
              Ranking cláusulas
            </p>
            <p class="mt-1 text-xl font-bold text-white">
              #{player.clausesRanking}
            </p>
          </div>
        </section>

        {extra && (
          <section class="grid grid-cols-3 gap-4">
            <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5 text-center">
              <p class="text-2xl font-bold text-white">{extra.matches}</p>
              <p class="mt-1 text-xs text-slate-500">Partidos</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5 text-center">
              <p class="text-2xl font-bold text-white">{extra.goals}</p>
              <p class="mt-1 text-xs text-slate-500">Goles</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5 text-center">
              <p class="text-2xl font-bold text-white">{extra.cards}</p>
              <p class="mt-1 text-xs text-slate-500">Tarjetas</p>
            </div>
          </section>
        )}

        {ligaLast && (
          <section class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <h2 class="text-xl font-bold text-white">En la liga Fantástica</h2>
            <p class="mt-1 text-sm text-slate-400">
              {ligaOwners.length > 0
                ? `Lo llevaban ${ligaOwners.length} de ${ligaLast.entries.length} participantes en la Jornada ${ligaLast.number}`
                : `Nadie lo llevaba en la Jornada ${ligaLast.number}`}
              {ligaInfo && ligaInfo.captainTimes > 0
                ? ` · capitán ${ligaInfo.captainTimes} ${ligaInfo.captainTimes === 1 ? "vez" : "veces"} en la temporada`
                : ""}
              .
            </p>
            {FAMILIA.map((name) => (
              <p
                data-yo-panel={name}
                hidden
                class={`mt-3 text-sm font-semibold ${ligaOwners.includes(name) ? "text-emerald-400" : "text-slate-300"}`}
              >
                {ligaOwners.includes(name)
                  ? `Lo tienes en tu 11 de la Jornada ${ligaLast.number}${ligaInfo?.captainedBy.includes(name) ? ", de capitán" : ""}.`
                  : `No está en tu 11 de la Jornada ${ligaLast.number}.`}
              </p>
            ))}

            <div class="mt-4 flex flex-wrap gap-2">
              {ligaPerJornada.map((j) => (
                <div class="w-14 rounded-lg bg-slate-950/40 px-2 py-1.5 text-center">
                  <p class="text-[10px] text-slate-500">J{j.jornada}</p>
                  <p class="text-sm font-semibold text-white">
                    {Math.round(j.pct)}%
                  </p>
                </div>
              ))}
            </div>

            {ligaOwners.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-1.5 text-xs">
                {ligaOwners.map((owner) => (
                  <li
                    data-participant={owner}
                    class="flex items-center gap-1.5 rounded-full border border-white/10 px-2.5 py-1 text-slate-300 data-[yo=true]:border-emerald-500/50 data-[yo=true]:text-emerald-400"
                  >
                    {FAMILIA_COLORS[owner] && (
                      <span
                        class="inline-block h-2 w-2 rounded-full"
                        style={`background:${FAMILIA_COLORS[owner]}`}
                      />
                    )}
                    {owner}
                    {ligaInfo?.captainedBy.includes(owner) && (
                      <span class="rounded bg-amber-400 px-1 text-[10px] font-bold text-slate-950">
                        C
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </section>
        )}

        {detail && !Array.isArray(detail.values_chart) && (
          <section class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <div class="mb-4 flex items-center justify-between">
              <h2 class="text-xl font-bold text-white">Evolución del valor</h2>
              <p class="text-xs text-slate-500">
                Máx {formatMoney(detail.values_chart.max.value)} (
                {detail.values_chart.max.date}) · Mín{" "}
                {formatMoney(detail.values_chart.min.value)} (
                {detail.values_chart.min.date})
              </p>
            </div>
            <LineChart
              points={detail.values_chart.points}
              title={`Evolución del valor de mercado de ${catalogEntry.name}`}
            />
          </section>
        )}

        <section>
          <h2 class="mb-1 text-xl font-bold text-white">Próximos partidos</h2>
          <p class="mb-4 text-sm text-slate-400">
            {nextXp !== null && nextFixtures[0]?.gameweek === nextGwNumber
              ? `≈${nextXp.toFixed(1).replace(".", ",")} pts esperados en la Jornada ${nextGwNumber}. `
              : ""}
            Dificultad del 1 (muy fácil) al 5 (muy difícil) según el rival, en
            casa o fuera.
          </p>
          {nextFixtures.length === 0 ? (
            <p class="text-sm text-slate-500">Sin partidos pendientes.</p>
          ) : (
            <div class="grid grid-cols-3 gap-2 sm:grid-cols-5">
              {nextFixtures.map((f) => (
                <div class="flex flex-col items-center gap-1.5 rounded-xl border border-white/10 bg-slate-900/60 p-3 text-center">
                  <span class="text-xs font-semibold text-slate-500">
                    J{f.gameweek} · {f.home ? "casa" : "fuera"}
                  </span>
                  <img
                    src={teamLogoUrl(f.rivalId)}
                    alt={f.rivalName}
                    class="h-8 w-8 object-contain"
                  />
                  <span class="line-clamp-1 text-xs text-slate-300">
                    {f.rivalName}
                  </span>
                  <span
                    class="rounded px-1.5 py-0.5 text-xs font-bold text-white"
                    style={`background:${DIFFICULTY_COLORS[f.difficulty]}`}
                    title={`Dificultad: ${DIFFICULTY_LABELS[f.difficulty]}`}
                  >
                    {f.difficulty} · {DIFFICULTY_LABELS[f.difficulty]}
                  </span>
                  {summary && (
                    <span class="text-xs font-semibold text-emerald-300">
                      ≈
                      {expectedPoints(summary, f.gameweek)
                        .toFixed(1)
                        .replace(".", ",")}{" "}
                      pts
                    </span>
                  )}
                </div>
              ))}
            </div>
          )}

          <h2 class="mt-8 mb-4 text-xl font-bold text-white">
            Últimas jornadas
          </h2>
          <div class="grid grid-cols-3 gap-2 sm:grid-cols-6">
            {recent.map((gw) => (
              <div class="flex flex-col items-center gap-1.5 rounded-xl border border-white/10 bg-slate-900/60 p-3 text-center">
                <span class="text-xs font-semibold text-slate-500">
                  {gw.shortName}
                </span>
                <img
                  src={gw.rivalLogoUrl}
                  alt="rival"
                  class="h-8 w-8 object-contain"
                />
                <span class="text-sm font-bold text-white">
                  {gw.points.points === null ? "—" : `${gw.points.points} pts`}
                </span>
              </div>
            ))}
          </div>

          {breakdown.length > 0 && statSeason && (
            <>
              <h2 class="mt-8 mb-1 text-xl font-bold text-white">
                De dónde salen sus puntos
              </h2>
              <p class="mb-4 text-sm text-slate-400">
                {Math.round(statSeason.minutes / statSeason.games)} min por
                partido · xG {fmt2(statSeason.xg)} · xA {fmt2(statSeason.xa)}
                {statSeason.ss !== null &&
                  ` · nota Sofascore ${fmt1(statSeason.ss)}`}
                .{" "}
                <a
                  href={url("/jugadores/desglose")}
                  class="text-emerald-400 hover:underline"
                >
                  ¿Qué pesa más?
                </a>
              </p>
              <div class="overflow-x-auto rounded-xl border border-white/10">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-white/10 bg-slate-900/80 text-xs tracking-wide text-slate-500 uppercase">
                      <th class="sticky left-0 bg-slate-900 px-3 py-2 text-left">
                        Estadística
                      </th>
                      <th class="px-3 py-2 text-right">Total</th>
                      {breakdown.map(([gw]) => (
                        <th class="px-2 py-2 text-center">J{gw}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {breakdownStats.map((k) => (
                      <tr class="border-b border-white/5">
                        <td class="sticky left-0 bg-slate-950 px-3 py-1.5 whitespace-nowrap text-slate-300">
                          {statLabel(k)}
                        </td>
                        <td class="px-3 py-1.5 text-right font-semibold text-white tabular-nums">
                          {statSeason.comp[k]?.pts ?? 0}
                        </td>
                        {breakdown.map(([gw, g]) => {
                          const cell = g.c?.[k];
                          const pts = cell?.[1] ?? 0;
                          return (
                            <td
                              class={`px-2 py-1.5 text-center tabular-nums ${pts > 0 ? "text-emerald-300" : pts < 0 ? "text-rose-300" : "text-slate-600"}`}
                              title={
                                cell
                                  ? `J${gw}: ${cell[0]} ${STATS[k]?.unit ?? ""} → ${pts} pts`
                                  : undefined
                              }
                            >
                              {pts ? (pts > 0 ? `+${pts}` : pts) : "·"}
                            </td>
                          );
                        })}
                      </tr>
                    ))}
                    <tr class="bg-slate-900/80 font-bold">
                      <td class="sticky left-0 bg-slate-900 px-3 py-2 text-white">
                        Puntos
                      </td>
                      <td class="px-3 py-2 text-right text-white tabular-nums">
                        {statSeason.points}
                      </td>
                      {breakdown.map(([, g]) => (
                        <td class="px-2 py-2 text-center text-white tabular-nums">
                          {g.points}
                        </td>
                      ))}
                    </tr>
                  </tbody>
                </table>
              </div>
            </>
          )}
        </section>

        {detail && detail.points_history.length > 0 && (
          <section>
            <h2 class="mb-4 text-xl font-bold text-white">
              Temporadas anteriores
            </h2>
            <div class="overflow-x-auto rounded-xl border border-white/10">
              <table class="w-full min-w-[420px] text-sm">
                <thead>
                  <tr class="border-b border-white/10 bg-slate-900/80 text-left text-xs tracking-wide text-slate-500 uppercase">
                    <th class="px-3 py-2">Temporada</th>
                    <th class="px-3 py-2">Puntos</th>
                    <th class="px-3 py-2">Media</th>
                    <th class="px-3 py-2">Última jornada</th>
                  </tr>
                </thead>
                <tbody>
                  {detail.points_history.map((season) => (
                    <tr class="border-b border-white/5">
                      <td class="px-3 py-2 font-medium text-white">
                        {season.season}
                      </td>
                      <td class="px-3 py-2 text-white">{season.points}</td>
                      <td class="px-3 py-2 text-slate-400">
                        {formatNumber(season.avg, 2)}
                      </td>
                      <td class="px-3 py-2 text-slate-400">
                        J{season.last_gameweek}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {player && (
          <section class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <h2 class="mb-4 text-xl font-bold text-white">
              Comparar con otro{" "}
              {POSITION_NAMES[catalogEntry.position]?.toLowerCase()}
            </h2>
            <select
              id="compare-select"
              aria-label="Jugador con el que comparar"
              data-position={catalogEntry.position}
              data-player={playerId}
              class="w-full max-w-sm rounded-xl border border-white/10 bg-slate-950/60 px-3 py-2.5 text-sm text-white focus:border-emerald-500/50 focus:outline-none sm:w-auto"
            >
              <option value="">Elige un jugador...</option>
            </select>
            <div id="compare-result" class="mt-4 hidden overflow-x-auto" />
          </section>
        )}
      </div>
    ) : (
      <p class="rounded-xl border border-white/10 bg-slate-900/60 p-6 text-center text-slate-400">
        Sin datos disponibles.
      </p>
    )
  }

  <script>
    // El comparador descarga los jugadores de la posición (comparar/N.json)
    // en vez de llevarlos incrustados en cada ficha.
    interface Row {
      id: number;
      name: string;
      team: string;
      price: number | null;
      points: number;
      avg: number;
      value: number;
      clause: number;
      xp: number;
      prob: number | null;
    }

    const select = document.getElementById(
      "compare-select",
    ) as HTMLSelectElement | null;
    const result = document.getElementById("compare-result");

    const money = new Intl.NumberFormat("es-ES", { maximumFractionDigits: 2 });
    const decimal = (digits: number) =>
      new Intl.NumberFormat("es-ES", {
        minimumFractionDigits: digits,
        maximumFractionDigits: digits,
      });
    const millions = (v: number | null) =>
      v === null ? "—" : `${money.format(v / 1_000_000)} M€`;
    const escapeHtml = (text: string) =>
      text.replace(
        /[&<>"]/g,
        (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!,
      );

    // better: "high" (gana el mayor), "low" (gana el menor: en la
    // Fantástica, el más barato) o null (no hay uno mejor).
    function metricRow(
      label: string,
      a: number | null,
      b: number | null,
      format: (v: number | null) => string,
      better: "high" | "low" | null = "high",
    ) {
      const both = better && a !== null && b !== null && a !== b;
      const aWins = both && (better === "high" ? a! > b! : a! < b!);
      const bWins = both && !aWins;
      return `
        <tr class="border-b border-white/5">
          <td class="px-3 py-2 text-slate-400">${label}</td>
          <td class="px-3 py-2 text-right font-semibold ${aWins ? "text-emerald-400" : "text-white"}">${format(a)}</td>
          <td class="px-3 py-2 text-right font-semibold ${bWins ? "text-emerald-400" : "text-white"}">${format(b)}</td>
        </tr>`;
    }

    async function setup(select: HTMLSelectElement, result: HTMLElement) {
      const base = document.body.dataset.base ?? "/";
      const response = await fetch(
        `${base}comparar/${select.dataset.position}.json`,
      );
      const rows = (await response.json()) as Row[];
      const me = rows.find((r) => r.id === Number(select.dataset.player));
      if (!me) return;
      const byId = new Map(rows.map((r) => [r.id, r]));
      select.insertAdjacentHTML(
        "beforeend",
        rows
          .filter((r) => r !== me)
          .map(
            (r) =>
              `<option value="${r.id}">${escapeHtml(r.name)} (${escapeHtml(r.team)})</option>`,
          )
          .join(""),
      );
      select.addEventListener("change", () => {
        const other = byId.get(Number(select.value));
        result.classList.toggle("hidden", !other);
        if (!other) return;
        const pts = (v: number | null) => (v === null ? "—" : String(v));
        result.innerHTML = `
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-white/10 text-left text-xs text-slate-500">
                <th class="px-3 py-2"></th>
                <th class="px-3 py-2 text-right">${escapeHtml(me.name)}</th>
                <th class="px-3 py-2 text-right">${escapeHtml(other.name)}</th>
              </tr>
            </thead>
            <tbody>
              ${metricRow("Precio Fantástica", me.price, other.price, millions, "low")}
              ${metricRow("Puntos esperados", me.xp, other.xp, (v) => (v === null ? "—" : `≈${decimal(1).format(v)}`))}
              ${metricRow("Titular", me.prob, other.prob, (v) => (v === null ? "—" : `${v}%`))}
              ${metricRow("Puntos", me.points, other.points, pts)}
              ${metricRow("Media", me.avg, other.avg, (v) => (v === null ? "—" : decimal(2).format(v)))}
              ${metricRow("Valor de mercado", me.value, other.value, millions, null)}
              ${metricRow("Cláusula", me.clause, other.clause, millions, null)}
            </tbody>
          </table>`;
      });
    }

    if (select && result) {
      setup(select, result).catch(() => {
        select.disabled = true;
        select.options[0].textContent = "Sin conexión: no se puede comparar";
      });
    }
  </script>
  <YoScript />
</Layout>
