---
import Layout from "../../layouts/Layout.astro";
import JugadoresTabs from "../../components/JugadoresTabs.astro";
import {
  getPlayerStats,
  playerPhotoUrl,
  POSITION_SHORT,
  url,
} from "../../lib/data";
import {
  STATS,
  activeStats,
  statLabel,
  statLeaders,
  statWeights,
} from "../../lib/desglose";

const gameweeks = [...getPlayerStats().keys()];
const positions = [
  { key: 0, label: "Todos" },
  ...[1, 2, 3, 4].map((p) => ({ key: p, label: POSITION_SHORT[p] })),
];

// Peso e influencia por posición (0 = todas), ordenadas por influencia.
const weights = positions.map((p) => ({
  position: p.key,
  rows: statWeights(p.key === 0 ? null : p.key).sort(
    (a, b) => b.influence - a.influence,
  ),
}));
const maxShare = Math.max(
  ...weights.flatMap((w) => w.rows.map((r) => Math.abs(r.share))),
  1,
);
const maxInfluence = Math.max(
  ...weights.flatMap((w) => w.rows.map((r) => Math.abs(r.influence))),
  1,
);
const fmt = (x: number) => x.toFixed(1).replace(".", ",");

const stats = activeStats();
// Se abre con la que más separa a unos jugadores de otros.
const mostInfluential = weights[0].rows[0]?.key;
const leaders = statLeaders(10);
const meta = Object.fromEntries(
  stats.map((k) => [
    k,
    {
      label: statLabel(k),
      unit: STATS[k]?.unit ?? "",
      negative: STATS[k]?.negative ?? false,
    },
  ]),
);
const playerUrlBase = url("/jugadores/");
const photoBase = playerPhotoUrl(0).replace(/0\.png$/, "");
---

<Layout
  title="Puntos por estadística"
  description="De qué estadísticas salen los puntos de Fantasy Marca y quién suma más con cada una"
>
  <h1 class="mb-4 text-3xl font-black text-white">Jugadores</h1>
  <JugadoresTabs active="desglose" />

  {
    gameweeks.length === 0 ? (
      <p class="rounded-xl border border-white/10 bg-slate-900/60 p-4 text-sm text-slate-400">
        Todavía no hay desglose de puntos descargado.
      </p>
    ) : (
      <div class="space-y-10">
        <section class="rounded-2xl border border-white/10 bg-slate-900/60 p-4 text-sm text-slate-300">
          <h2 class="text-lg font-bold text-white">
            De dónde salen los puntos
          </h2>
          <p class="mt-1">
            Marca puntúa cada partido con estadísticas: minutos, goles,
            asistencias, portería a cero, paradas, pases clave, regates,
            despejes, balones perdidos, tarjetas… más las estrellas de su
            cronista. Desglose de las jornadas {gameweeks[0]}–{gameweeks.at(-1)}
            .
          </p>
          <div
            class="mt-3 flex flex-wrap gap-2"
            role="group"
            aria-label="Posición"
          >
            {positions.map((p) => (
              <button
                type="button"
                data-pos-btn={p.key}
                aria-pressed={p.key === 0 ? "true" : "false"}
                class="pos-btn rounded-full border border-white/10 px-3 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:bg-white/5 hover:text-white aria-pressed:border-emerald-500/40 aria-pressed:bg-emerald-500/10 aria-pressed:text-emerald-400"
              >
                {p.label}
              </button>
            ))}
          </div>
        </section>

        <section id="peso">
          <h2 class="text-xl font-bold text-white">
            Qué estadísticas pesan y cuáles marcan la diferencia
          </h2>
          <p class="mt-1 mb-4 text-sm text-slate-400">
            <b class="text-slate-200">Peso</b>: de cada 100 puntos, cuántos
            salen de esa estadística. <b class="text-slate-200">Influencia</b>:
            cuánto explica de la diferencia de puntos por partido entre unos
            jugadores y otros (con 3+ partidos; entre todas suman 100%). Los
            minutos pesan mucho, pero casi todos los titulares los sacan igual:
            influyen poco.
          </p>
          {weights.map((w) => (
            <div
              data-pos-view={w.position}
              hidden={w.position !== 0}
              class="space-y-2"
            >
              {w.rows.map((r) => (
                <div class="rounded-xl border border-white/10 bg-slate-900/60 p-3">
                  <div class="flex items-baseline justify-between gap-2">
                    <p class="truncate text-sm font-medium text-white">
                      {statLabel(r.key)}
                    </p>
                    <p class="shrink-0 text-xs text-slate-500">
                      {r.pts > 0 ? "+" : ""}
                      {Math.round(r.pts)} pts en total
                    </p>
                  </div>
                  <div class="mt-2 grid grid-cols-[4.5rem_1fr_3.5rem] items-center gap-x-2 gap-y-1.5 text-xs">
                    <span class="text-slate-400">Peso</span>
                    <div class="h-1.5 overflow-hidden rounded-full bg-slate-800">
                      <div
                        class={`h-full rounded-full ${r.share < 0 ? "bg-rose-500" : "bg-emerald-500"}`}
                        style={`width:${Math.max((Math.abs(r.share) / maxShare) * 100, 2)}%`}
                      />
                    </div>
                    <span
                      class={`text-right font-semibold ${r.share < 0 ? "text-rose-400" : "text-emerald-400"}`}
                    >
                      {fmt(r.share)}%
                    </span>
                    <span class="text-slate-400">Influencia</span>
                    <div class="h-1.5 overflow-hidden rounded-full bg-slate-800">
                      <div
                        class="h-full rounded-full bg-sky-500"
                        style={`width:${Math.max((Math.max(r.influence, 0) / maxInfluence) * 100, 2)}%`}
                      />
                    </div>
                    <span class="text-right font-semibold text-sky-300">
                      {fmt(r.influence)}%
                    </span>
                  </div>
                </div>
              ))}
            </div>
          ))}
        </section>

        <section id="lideres">
          <h2 class="text-xl font-bold text-white">
            Quién más suma con cada estadística
          </h2>
          <p class="mt-1 mb-3 text-sm text-slate-400">
            Puntos de la temporada que le ha dado esa estadística (en las que
            restan, quién más ha perdido).
          </p>
          <label for="stat-pick" class="sr-only">
            Estadística
          </label>
          <select
            id="stat-pick"
            class="mb-4 w-full rounded-xl border border-white/10 bg-slate-900 px-3 py-2 text-sm text-white sm:w-auto"
          >
            {stats.map((k) => (
              <option value={k} selected={k === mostInfluential}>
                {statLabel(k)}
              </option>
            ))}
          </select>
          <p id="stat-help" class="mb-3 text-xs text-slate-500" />
          <ol id="stat-leaders" class="space-y-2" />
        </section>

        <section id="reglas">
          <h2 class="mb-3 text-xl font-bold text-white">
            Cuánto da cada estadística
          </h2>
          <p class="mb-3 text-sm text-slate-400">
            Aproximado, sacado de los desgloses: Marca no publica la tabla
            exacta y algunas dependen de la posición.
          </p>
          <dl class="grid grid-cols-1 gap-2 sm:grid-cols-2">
            {stats
              .filter((k) => STATS[k])
              .map((k) => (
                <div class="rounded-xl border border-white/10 bg-slate-900/60 p-3">
                  <dt class="text-sm font-medium text-white">{statLabel(k)}</dt>
                  <dd class="mt-0.5 text-xs text-slate-400">{STATS[k].help}</dd>
                </div>
              ))}
          </dl>
        </section>
      </div>
    )
  }

  <script
    define:vars={{
      leaders,
      meta,
      help: Object.fromEntries(stats.map((k) => [k, STATS[k]?.help ?? ""])),
      positionShort: POSITION_SHORT,
      playerUrlBase,
      photoBase,
    }}
  >
    const pick = document.getElementById("stat-pick");
    const list = document.getElementById("stat-leaders");
    const helpEl = document.getElementById("stat-help");
    let position = 0;

    function escapeHtml(text) {
      return String(text).replace(
        /[&<>"]/g,
        (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c],
      );
    }
    const num = (x) => (Math.round(x * 10) / 10).toString().replace(".", ",");

    function render() {
      if (!pick || !list) return;
      const key = pick.value;
      const m = meta[key];
      const rows = leaders[key]?.[position] ?? [];
      if (helpEl) helpEl.textContent = help[key] ?? "";
      const max = Math.max(...rows.map((r) => Math.abs(r.pts)), 1);
      list.innerHTML = rows.length
        ? rows
            .map((r, i) => {
              const text = m.negative ? "text-rose-400" : "text-emerald-400";
              const bar = m.negative ? "bg-rose-500" : "bg-emerald-500";
              const value =
                key === "minutesPlayed"
                  ? `${Math.round(r.value)} min`
                  : `${num(r.value)} ${escapeHtml(m.unit)}`;
              return `<li><a href="${playerUrlBase}${r.id}/" class="flex items-center gap-3 rounded-xl border border-white/10 bg-slate-900/60 p-3 transition-colors hover:border-emerald-500/30 hover:bg-slate-900">
                <span class="w-5 shrink-0 text-center text-sm font-bold text-slate-500">${i + 1}</span>
                <img src="${photoBase}${r.id}.png" alt="" class="h-8 w-8 shrink-0 rounded-full bg-slate-800 object-cover" loading="lazy" />
                <div class="min-w-0 flex-1">
                  <div class="flex items-center justify-between gap-2">
                    <p class="truncate text-sm font-medium text-white">${escapeHtml(r.name)}</p>
                    <p class="shrink-0 text-sm font-bold ${text}">${r.pts > 0 ? "+" : ""}${num(r.pts)} pts</p>
                  </div>
                  <p class="truncate text-xs text-slate-500">${positionShort[r.position]} · ${escapeHtml(r.team)} · ${value} · ${num(r.pts / r.games)} pts/partido</p>
                  <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-slate-800">
                    <div class="h-full rounded-full ${bar}" style="width:${Math.max((Math.abs(r.pts) / max) * 100, 3)}%"></div>
                  </div>
                </div>
              </a></li>`;
            })
            .join("")
        : `<li class="text-sm text-slate-500">Nadie de esta posición ha sumado con esta estadística.</li>`;
    }

    function setPosition(p) {
      position = p;
      document.querySelectorAll("[data-pos-btn]").forEach((b) => {
        b.setAttribute(
          "aria-pressed",
          String(Number(b.dataset.posBtn) === position),
        );
      });
      document.querySelectorAll("[data-pos-view]").forEach((v) => {
        v.hidden = Number(v.dataset.posView) !== position;
      });
      render();
    }

    document.querySelectorAll("[data-pos-btn]").forEach((b) => {
      b.addEventListener("click", () => setPosition(Number(b.dataset.posBtn)));
    });
    pick?.addEventListener("change", render);
    render();
  </script>
</Layout>
