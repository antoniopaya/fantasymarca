---
import Layout from "../layouts/Layout.astro";
import RankingList from "../components/RankingList.astro";
import PlayersTable from "../components/PlayersTable.astro";
import DonutChart from "../components/charts/DonutChart.astro";
import CategoryBarChart from "../components/charts/CategoryBarChart.astro";
import Histogram from "../components/charts/Histogram.astro";
import ScatterPlot from "../components/charts/ScatterPlot.astro";
import {
  getAllPlayerSummaries,
  getTeams,
  getNextGameweek,
  formatMoney,
  playerPhotoUrl,
  teamLogoUrl,
  POSITION_NAMES,
  POSITION_COLORS,
  url,
} from "../lib/data";

const summaries = getAllPlayerSummaries();
const teams = getTeams();

function pct(value: number, max: number): number {
  return max > 0 ? (value / max) * 100 : 0;
}

// --- Puntos: lo primero, es lo que de verdad importa para jugar bien ---
const byLastSeason = summaries
  .filter((s) => s.lastSeason !== null)
  .sort((a, b) => (b.lastSeason?.points ?? 0) - (a.lastSeason?.points ?? 0));
const topLastSeason = byLastSeason.slice(0, 10);
const maxLastSeasonPoints = topLastSeason[0]?.lastSeason?.points ?? 1;
const lastSeasonLabel = topLastSeason[0]?.lastSeason?.season ?? "";

const currentSeasonLabel = getNextGameweek().season ?? "26/27";
const scatterSeasons = [
  { key: "lastSeason", label: `Temporada ${lastSeasonLabel}` },
  { key: "current", label: `Temporada actual (${currentSeasonLabel})` },
];

// Solo jugadores con precio Fantástica: es el precio que de verdad usamos, el de
// mercado ya se muestra en su propia sección.
const scatterPlayers = summaries
  .filter((s) => s.precioFantastica !== null)
  .map((s) => ({
    id: s.id,
    name: s.name,
    teamName: s.team_name,
    photoUrl: playerPhotoUrl(s.id),
    position: s.position,
    price: Math.round(((s.precioFantastica as number) / 1_000_000) * 100) / 100,
    pointsBySeason: {
      current: s.points,
      lastSeason: s.lastSeason?.points ?? null,
    },
    href: url(`/jugadores/${s.id}`),
  }));

// --- Posiciones ---
// El nº de jugadores por posición cuenta el catálogo entero (no depende del precio);
// el precio medio solo puede salir de los que sí tienen precio Fantástica.
const positionStats = ([1, 2, 3, 4] as const).map((position) => {
  const group = summaries.filter((s) => s.position === position);
  const priced = group.filter((s) => s.precioFantastica !== null);
  const totalFantastica = priced.reduce(
    (sum, s) => sum + (s.precioFantastica as number),
    0,
  );
  return {
    position,
    count: group.length,
    avgFantastica: priced.length ? totalFantastica / priced.length : 0,
    color: POSITION_COLORS[position],
  };
});

// --- Precio Fantástica ---
const byFantastica = summaries
  .filter((s) => s.precioFantastica !== null)
  .sort(
    (a, b) => (b.precioFantastica as number) - (a.precioFantastica as number),
  );
const topFantastica = byFantastica.slice(0, 10);
const maxFantastica = topFantastica[0]?.precioFantastica ?? 1;

// --- Gangas: el mercado ya paga mucho más de lo que cuesta en la liga ---
const bargains = byFantastica
  .filter((s) => s.value > (s.precioFantastica as number))
  .map((s) => ({
    ...s,
    bargainPct:
      ((s.value - (s.precioFantastica as number)) /
        (s.precioFantastica as number)) *
      100,
  }))
  .sort((a, b) => b.bargainPct - a.bargainPct)
  .slice(0, 10);
const maxBargainPct = bargains[0]?.bargainPct ?? 1;

// --- Ratio puntos/precio: rendimiento por millón pagado en la liga ---
const valueForMoney = byFantastica
  .filter((s) => (s.lastSeason?.points ?? 0) > 0)
  .map((s) => ({
    ...s,
    ratio:
      (s.lastSeason?.points ?? 0) /
      ((s.precioFantastica as number) / 1_000_000),
  }))
  .sort((a, b) => b.ratio - a.ratio)
  .slice(0, 10);
const maxRatio = valueForMoney[0]?.ratio ?? 1;

const byClause = [...summaries].sort((a, b) => b.clauseValue - a.clauseValue);
const topClause = byClause.slice(0, 10);
const maxClause = topClause[0]?.clauseValue ?? 1;

const risers = summaries
  .filter((s) => s.weeklyChange > 0)
  .sort((a, b) => b.weeklyChange - a.weeklyChange)
  .slice(0, 6);
const maxRise = risers[0]?.weeklyChange ?? 1;

const fallers = summaries
  .filter((s) => s.weeklyChange < 0)
  .sort((a, b) => a.weeklyChange - b.weeklyChange)
  .slice(0, 6);
const maxFall = Math.abs(fallers[0]?.weeklyChange ?? -1);

const pricedSummaries = summaries.filter((s) => s.precioFantastica !== null);
const fantasticaBuckets = [
  { label: "<12M", min: 0, max: 12_000_000 },
  { label: "12-15M", min: 12_000_000, max: 15_000_000 },
  { label: "15-18M", min: 15_000_000, max: 18_000_000 },
  { label: "18-21M", min: 18_000_000, max: 21_000_000 },
  { label: "21-24M", min: 21_000_000, max: 24_000_000 },
  { label: "24M+", min: 24_000_000, max: Infinity },
].map((bucket) => ({
  label: bucket.label,
  count: pricedSummaries.filter(
    (s) =>
      (s.precioFantastica as number) >= bucket.min &&
      (s.precioFantastica as number) < bucket.max,
  ).length,
}));

const teamTotals = teams
  .map((team) => {
    const squad = summaries.filter((s) => s.id_team === team.id);
    const priced = squad.filter((s) => s.precioFantastica !== null);
    const totalFantastica = priced.reduce(
      (sum, s) => sum + (s.precioFantastica as number),
      0,
    );
    const avgFantastica = priced.length ? totalFantastica / priced.length : 0;
    return { team, totalFantastica, avgFantastica, count: squad.length };
  })
  .sort((a, b) => b.totalFantastica - a.totalFantastica);
const maxTeamFantastica = teamTotals[0]?.totalFantastica ?? 1;

// Índice de la sidebar: mismo id/orden que las secciones de más abajo.
// El gráfico precio-vs-puntos va primero: es el más útil para decidir fichajes.
const sections = [
  { id: "valor-vs-puntos", label: "Precio vs. puntos" },
  { id: "gangas", label: "Gangas" },
  { id: "puntos", label: "Puntos" },
  { id: "posiciones", label: "Posiciones" },
  { id: "distribucion-valor", label: "Distribución de precios" },
  { id: "mas-valiosos", label: "Más valiosos" },
  { id: "ratio-puntos-precio", label: "Ratio puntos/precio" },
  { id: "clausulas", label: "Cláusulas" },
  { id: "subidas", label: "Subidas de valor" },
  { id: "bajadas", label: "Bajadas de valor" },
  { id: "equipos", label: "Por equipo" },
  { id: "todos", label: "Todos los jugadores" },
];
---

<Layout
  title="Estadísticas"
  description="Puntos, precio Fantástica, valor de mercado y cláusulas en Fantasy Marca"
>
  <div class="mb-8">
    <h1 class="text-3xl font-black text-white">Estadísticas y análisis</h1>
    <p class="mt-1 text-sm text-slate-400">
      Basado en el catálogo completo de {summaries.length} jugadores
    </p>
  </div>

  <nav
    id="stats-mobile-nav"
    aria-label="Secciones"
    class="-mx-4 mb-6 flex gap-2 overflow-x-auto px-4 pb-1 lg:hidden"
  >
    {
      sections.map((s) => (
        <a
          href={`#${s.id}`}
          data-stats-nav-link
          data-section={s.id}
          data-base-class="text-slate-300"
          class="stats-nav-link shrink-0 rounded-full border border-white/10 px-3 py-1.5 text-xs font-medium whitespace-nowrap text-slate-300 transition-colors hover:bg-white/5 hover:text-white"
        >
          {s.label}
        </a>
      ))
    }
  </nav>

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-[200px_1fr]">
    <nav aria-label="Secciones" class="hidden lg:block">
      <div class="sticky top-20 space-y-1">
        {
          sections.map((s) => (
            <a
              href={`#${s.id}`}
              data-stats-nav-link
              data-section={s.id}
              data-base-class="text-slate-400"
              class="stats-nav-link block rounded-lg px-3 py-2 text-sm font-medium text-slate-400 transition-colors hover:bg-white/5 hover:text-white"
            >
              {s.label}
            </a>
          ))
        }
      </div>
    </nav>

    <div class="min-w-0">
      <section id="valor-vs-puntos" class="mb-10 scroll-mt-24">
        <h2 class="mb-4 text-xl font-bold text-white">
          Precio Fantástica vs. puntos
        </h2>
        <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4">
          <ScatterPlot
            players={scatterPlayers}
            seasons={scatterSeasons}
            defaultSeasonKey="lastSeason"
            yLabel="Precio Fantástica (M€)"
            positionColors={POSITION_COLORS}
            positionNames={POSITION_NAMES}
          />
        </div>
      </section>

      <section id="gangas" class="mb-10 scroll-mt-24">
        <h2 class="mb-4 text-xl font-bold text-white">Gangas</h2>
        <p class="mb-4 text-sm text-slate-500">
          Jugadores cuyo valor de mercado ya está muy por encima de lo que
          cuestan en la liga: la mejor relación calidad-precio para fichar en tu
          once.
        </p>
        {
          bargains.length === 0 ? (
            <p class="rounded-xl border border-white/10 bg-slate-900/60 p-4 text-sm text-slate-500">
              Ahora mismo nadie cuesta menos en la liga de lo que vale en el
              mercado.
            </p>
          ) : (
            <RankingList
              items={bargains.map((p) => ({
                key: p.id,
                label: p.name,
                sublabel: `${p.team_name} · Fantástica ${formatMoney(p.precioFantastica as number)} · Mercado ${formatMoney(p.value)}`,
                valueLabel: `▲ ${p.bargainPct.toFixed(0)}%`,
                barPercent: pct(p.bargainPct, maxBargainPct),
                href: url(`/jugadores/${p.id}`),
                imageUrl: playerPhotoUrl(p.id),
                accent: "positive" as const,
              }))}
            />
          )
        }
      </section>

      <section id="puntos" class="mb-10 scroll-mt-24">
        <h2 class="mb-4 text-xl font-bold text-white">
          Mejores de la {lastSeasonLabel} (puntos)
        </h2>
        <p class="mb-4 text-sm text-slate-500">
          La temporada 26/27 no ha empezado — en cuanto se jueguen jornadas y
          actualices los datos, esta sección pasará a mostrar los puntos de la
          temporada actual.
        </p>
        <RankingList
          items={topLastSeason.map((p) => ({
            key: p.id,
            label: p.name,
            sublabel: `${p.team_name} · media ${p.lastSeason?.avg.toFixed(2)}`,
            valueLabel: `${p.lastSeason?.points} pts`,
            barPercent: pct(p.lastSeason?.points ?? 0, maxLastSeasonPoints),
            href: url(`/jugadores/${p.id}`),
            imageUrl: playerPhotoUrl(p.id),
          }))}
        />
      </section>

      <section id="posiciones" class="mb-10 scroll-mt-24">
        <h2 class="mb-4 text-xl font-bold text-white">
          Distribución por posición
        </h2>
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-6">
            <p class="mb-4 text-sm font-medium text-slate-400">
              Jugadores por posición
            </p>
            <DonutChart
              segments={positionStats.map((s) => ({
                label: POSITION_NAMES[s.position],
                value: s.count,
                color: s.color,
              }))}
              centerValue={String(summaries.length)}
              centerLabel="jugadores"
            />
          </div>
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-6">
            <p class="mb-4 text-sm font-medium text-slate-400">
              Precio Fantástica medio por posición
            </p>
            <CategoryBarChart
              title="Precio Fantástica medio por posición"
              bars={positionStats.map((s) => ({
                label: POSITION_NAMES[s.position].slice(0, 3).toUpperCase(),
                value: s.avgFantastica,
                color: s.color,
                valueLabel: formatMoney(s.avgFantastica),
              }))}
            />
          </div>
        </div>
      </section>

      <section id="distribucion-valor" class="mb-10 scroll-mt-24">
        <h2 class="mb-4 text-xl font-bold text-white">
          Distribución de precios Fantástica
        </h2>
        <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4">
          <Histogram
            buckets={fantasticaBuckets}
            title="Distribución de precios Fantástica"
          />
        </div>
      </section>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        <section id="mas-valiosos" class="scroll-mt-24">
          <h2 class="mb-4 text-xl font-bold text-white">
            Mayor precio Fantástica
          </h2>
          <RankingList
            items={topFantastica.map((p) => ({
              key: p.id,
              label: p.name,
              sublabel: p.team_name,
              valueLabel: formatMoney(p.precioFantastica as number),
              barPercent: pct(p.precioFantastica as number, maxFantastica),
              href: url(`/jugadores/${p.id}`),
              imageUrl: playerPhotoUrl(p.id),
            }))}
          />
        </section>

        <section id="ratio-puntos-precio" class="scroll-mt-24">
          <h2 class="mb-4 text-xl font-bold text-white">Ratio puntos/precio</h2>
          {
            valueForMoney.length === 0 ? (
              <p class="rounded-xl border border-white/10 bg-slate-900/60 p-4 text-sm text-slate-500">
                Todavía no hay puntos de la {lastSeasonLabel} para calcular el
                ratio.
              </p>
            ) : (
              <RankingList
                items={valueForMoney.map((p) => ({
                  key: p.id,
                  label: p.name,
                  sublabel: `${p.team_name} · ${p.lastSeason?.points} pts · ${formatMoney(p.precioFantastica as number)}`,
                  valueLabel: `${p.ratio.toFixed(1)} pts/M€`,
                  barPercent: pct(p.ratio, maxRatio),
                  href: url(`/jugadores/${p.id}`),
                  imageUrl: playerPhotoUrl(p.id),
                }))}
              />
            )
          }
        </section>

        <section id="clausulas" class="scroll-mt-24">
          <h2 class="mb-4 text-xl font-bold text-white">Cláusulas más altas</h2>
          <RankingList
            items={topClause.map((p) => ({
              key: p.id,
              label: p.name,
              sublabel: p.team_name,
              valueLabel: formatMoney(p.clauseValue),
              barPercent: pct(p.clauseValue, maxClause),
              href: url(`/jugadores/${p.id}`),
              imageUrl: playerPhotoUrl(p.id),
            }))}
          />
        </section>

        <section id="subidas" class="scroll-mt-24">
          <h2 class="mb-4 text-xl font-bold text-white">
            Mayor subida de valor (semana)
          </h2>
          {
            risers.length === 0 ? (
              <p class="rounded-xl border border-white/10 bg-slate-900/60 p-4 text-sm text-slate-500">
                Nadie ha subido de valor esta semana todavía.
              </p>
            ) : (
              <RankingList
                items={risers.map((p) => ({
                  key: p.id,
                  label: p.name,
                  sublabel: p.team_name,
                  valueLabel: `▲ ${formatMoney(p.weeklyChange)}`,
                  barPercent: pct(p.weeklyChange, maxRise),
                  href: url(`/jugadores/${p.id}`),
                  imageUrl: playerPhotoUrl(p.id),
                  accent: "positive" as const,
                }))}
              />
            )
          }
        </section>

        <section id="bajadas" class="scroll-mt-24">
          <h2 class="mb-4 text-xl font-bold text-white">
            Mayor caída de valor (semana)
          </h2>
          {
            fallers.length === 0 ? (
              <p class="rounded-xl border border-white/10 bg-slate-900/60 p-4 text-sm text-slate-500">
                Nadie ha bajado de valor esta semana todavía.
              </p>
            ) : (
              <RankingList
                items={fallers.map((p) => ({
                  key: p.id,
                  label: p.name,
                  sublabel: p.team_name,
                  valueLabel: `▼ ${formatMoney(Math.abs(p.weeklyChange))}`,
                  barPercent: pct(Math.abs(p.weeklyChange), maxFall),
                  href: url(`/jugadores/${p.id}`),
                  imageUrl: playerPhotoUrl(p.id),
                  accent: "negative" as const,
                }))}
              />
            )
          }
        </section>
      </div>

      <section id="equipos" class="mt-10 scroll-mt-24">
        <h2 class="mb-4 text-xl font-bold text-white">
          Precio Fantástica total de plantilla por equipo
        </h2>
        <div class="space-y-2">
          {
            teamTotals.map((t, index) => (
              <div class="flex items-center gap-3 rounded-xl border border-white/10 bg-slate-900/60 p-3">
                <span class="w-5 shrink-0 text-center text-sm font-bold text-slate-600">
                  {index + 1}
                </span>
                <img
                  src={teamLogoUrl(t.team.id)}
                  alt=""
                  class="h-8 w-8 shrink-0 object-contain"
                  loading="lazy"
                />
                <div class="min-w-0 flex-1">
                  <div class="flex items-center justify-between gap-2">
                    <p class="truncate text-sm font-medium text-white">
                      {t.team.name}
                    </p>
                    <p class="shrink-0 text-sm font-bold text-white">
                      {formatMoney(t.totalFantastica)}
                    </p>
                  </div>
                  <p class="text-xs text-slate-500">
                    {t.count} jugadores · media {formatMoney(t.avgFantastica)}
                  </p>
                  <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-slate-800">
                    <div
                      class="h-full rounded-full bg-emerald-500"
                      style={`width:${Math.max(pct(t.totalFantastica, maxTeamFantastica), 3)}%`}
                    />
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section id="todos" class="mt-10 scroll-mt-24">
        <h2 class="mb-4 text-xl font-bold text-white">Todos los jugadores</h2>
        <p class="mb-4 text-sm text-slate-500">
          Busca, filtra por equipo/posición y ordena cualquier columna haciendo
          clic en la cabecera.
        </p>
        <PlayersTable players={summaries} teams={teams} />
      </section>
    </div>
  </div>
</Layout>

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-stats-nav-link]"),
  );

  // Ambos navs (pills en móvil, sidebar en escritorio) apuntan a las mismas
  // secciones, así que solo hace falta observar cada <section> una vez.
  const sectionIds = new Set(
    links
      .map((link) => link.dataset.section)
      .filter((id): id is string => !!id),
  );
  const sectionEls = Array.from(sectionIds)
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  let activeId: string | null = null;

  function setActive(id: string) {
    if (id === activeId) return;
    activeId = id;
    for (const link of links) {
      const isActive = link.dataset.section === id;
      const baseClass = link.dataset.baseClass ?? "text-slate-400";
      link.classList.toggle("bg-emerald-500/10", isActive);
      link.classList.toggle("text-emerald-400", isActive);
      link.classList.toggle(baseClass, !isActive);
    }
    // Centrar el pill activo dentro del nav móvil, sin tocar el scroll vertical
    // de la página: scrollIntoView con block:"nearest" arrastraba la página entera
    // hacia arriba en cuanto el nav (que no es sticky) quedaba fuera de vista.
    const mobileNav = document.getElementById("stats-mobile-nav");
    const mobileActive = mobileNav?.querySelector<HTMLElement>(
      `[data-section="${id}"]`,
    );
    if (mobileNav && mobileActive) {
      const target =
        mobileActive.offsetLeft -
        mobileNav.clientWidth / 2 +
        mobileActive.clientWidth / 2;
      mobileNav.scrollTo({ left: target, behavior: "smooth" });
    }
  }

  // Arriba del todo no hay scroll aún que dispare el observer, así que se marca
  // la primera sección activa desde ya en vez de dejar la barra en blanco.
  if (sectionEls[0]) setActive(sectionEls[0].id);

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) setActive(entry.target.id);
      }
    },
    { rootMargin: "-96px 0px -75% 0px", threshold: 0 },
  );

  for (const el of sectionEls) observer.observe(el);
</script>
