---
import Layout from "../layouts/Layout.astro";
import {
  getAllPlayerSummaries,
  getNextGameweek,
  getMatches,
  playerPhotoUrl,
  teamLogoUrl,
  POSITION_SHORT,
  PLAYER_STATUS_LABELS,
  formatMoney,
  getLatestLigaJornada,
  getLigaJornadas,
  getGameweekPoints,
  url,
  FORMATIONS,
  MAX_BUDGET,
  MAX_CAPTAIN_PRICE,
} from "../lib/data";
import { FAMILIA, YO_EVENT, YO_STORAGE_KEY } from "../lib/yo";

const ligaJornada = getLatestLigaJornada();

// % de participantes de la liga que llevaban a cada jugador en la última jornada.
const ownership = new Map<number, number>();
for (const entry of ligaJornada?.entries ?? []) {
  for (const p of entry.players) {
    if (p.id !== null) ownership.set(p.id, (ownership.get(p.id) ?? 0) + 1);
  }
}
const ligaSize = ligaJornada?.entries.length ?? 0;

// Nombre corto para las fichas del campo: el que usa la liga en sus PDFs
// ("Fermín L.", "Vinicius Jr.") si lo ha usado alguna vez; si no, el apellido.
const ligaShortNames = new Map<number, string>();
for (const j of getLigaJornadas()) {
  for (const e of j.entries) {
    for (const p of e.players)
      if (p.id !== null) ligaShortNames.set(p.id, p.name);
  }
}
const shortName = (id: number, name: string) =>
  ligaShortNames.get(id) ?? name.split(" ").slice(-1)[0];

const nextGameweek = getNextGameweek();
const lastPlayedGw = nextGameweek.number - 1;

// Solo entran jugadores con precio Fantástica: es el único precio que cuenta
// para el tope de 180M, así que uno sin precio no se puede valorar ni incluir.
const players = getAllPlayerSummaries()
  .filter((p) => p.precioFantastica !== null)
  .map((p) => ({
    id: p.id,
    name: p.name,
    teamName: p.team_name,
    id_team: p.id_team,
    position: p.position,
    price: p.precioFantastica as number,
    photoUrl: playerPhotoUrl(p.id),
    teamLogoUrl: teamLogoUrl(p.id_team),
    status: p.status,
    shortName: shortName(p.id, p.name),
    avg: p.avg,
    lastGwPoints: getGameweekPoints(p.id, lastPlayedGw),
    points: p.points,
    form: p.form,
    ownershipPct: ligaSize
      ? Math.round(((ownership.get(p.id) ?? 0) / ligaSize) * 100)
      : 0,
  }));
const pricedIds = new Set(players.map((p) => p.id));

const DEFAULT_FORMATION = "4-3-3";

// El once que puso cada uno de la familia en la última jornada de la liga,
// listo para cargarlo como punto de partida de los cambios de la siguiente.
const positionById = new Map(
  getAllPlayerSummaries().map((p) => [p.id, p.position]),
);
const LIGA_ONCES: Record<
  string,
  {
    jornada: number;
    formationKey: string;
    slots: { position: number; playerId: number }[];
    captainId: number | null;
    changes: number;
    missing: string[];
  }
> = {};
for (const name of FAMILIA) {
  const entry = ligaJornada?.entries.find((e) => e.participant === name);
  if (!ligaJornada || !entry) continue;
  const inCatalog = entry.players.filter(
    (p): p is typeof p & { id: number } => p.id !== null && pricedIds.has(p.id),
  );
  const slots = inCatalog
    .map((p) => ({ position: positionById.get(p.id) ?? 0, playerId: p.id }))
    .sort((a, b) => a.position - b.position);
  const count = (pos: number) => slots.filter((s) => s.position === pos).length;
  const formationKey = `${count(2)}-${count(3)}-${count(4)}`;
  LIGA_ONCES[name] = {
    jornada: ligaJornada.number,
    formationKey: FORMATIONS.some((f) => f.key === formationKey)
      ? formationKey
      : DEFAULT_FORMATION,
    slots,
    captainId: inCatalog.find((p) => p.captain)?.id ?? null,
    changes: entry.changes ?? 11,
    missing: entry.players
      .filter((p) => p.id === null || !pricedIds.has(p.id))
      .map((p) => p.name),
  };
}

// Para el resumen de "próximos rivales": qué equipo le toca a cada equipo en
// la próxima jornada, con su escudo, para poder cruzarlo con los equipos
// presentes en el once.
let nextGwMatches: ReturnType<typeof getMatches> = [];
try {
  nextGwMatches = getMatches(nextGameweek.number);
} catch {
  nextGwMatches = [];
}
const TEAM_NEXT_OPPONENT: Record<number, { name: string; logoUrl: string }> =
  {};
for (const m of nextGwMatches) {
  TEAM_NEXT_OPPONENT[m.id_home] = {
    name: m.away,
    logoUrl: teamLogoUrl(m.id_away),
  };
  TEAM_NEXT_OPPONENT[m.id_away] = {
    name: m.home,
    logoUrl: teamLogoUrl(m.id_home),
  };
}
---

<Layout
  title="Mi 11"
  description="Prepara tu 11 de la liga Fantástica: cambios, capitán y presupuesto de 180M€."
>
  <h1 class="sr-only">Mi 11</h1>

  <div
    id="page-notice"
    class="mb-4 hidden rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-300"
  >
  </div>

  <div
    id="liga-panel"
    class="mb-4 hidden rounded-2xl border border-emerald-500/30 bg-emerald-500/5 p-4"
  >
  </div>

  <div
    id="once-bar"
    class="sticky top-[calc(62px+env(safe-area-inset-top))] z-30 -mx-4 mb-4 border-b border-white/10 bg-slate-950/95 px-4 py-2.5 backdrop-blur-md sm:mx-0 sm:rounded-2xl sm:border"
  >
    <div class="flex items-center gap-2">
      <label for="lineup-select" class="sr-only">Convocatoria</label>
      <select
        id="lineup-select"
        class="min-w-0 flex-1 truncate rounded-full border border-white/10 bg-slate-900/60 px-3 py-2 text-sm font-semibold text-white focus:border-emerald-500/50 focus:outline-none sm:max-w-xs sm:flex-none"
      >
      </select>
      <button
        type="button"
        id="share-whatsapp"
        class="shrink-0 rounded-full bg-emerald-500 px-3.5 py-2 text-sm font-semibold text-slate-950 disabled:pointer-events-none disabled:opacity-40"
      >
        WhatsApp
      </button>
      <details id="once-menu" class="relative shrink-0">
        <summary
          aria-label="Más opciones"
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full border border-white/10 text-lg text-slate-200 hover:bg-white/5 [&::-webkit-details-marker]:hidden"
        >
          ⋯
        </summary>
        <div
          class="absolute right-0 z-40 mt-2 w-72 space-y-4 rounded-2xl border border-white/10 bg-slate-900 p-4 shadow-2xl"
        >
          <div>
            <p
              class="mb-2 text-xs font-semibold tracking-wide text-slate-500 uppercase"
            >
              Cambios de jornada
            </p>
            <div id="changes-panel"></div>
          </div>
          <div>
            <label
              for="formation-select"
              class="mb-2 block text-xs font-semibold tracking-wide text-slate-500 uppercase"
            >
              Formación
            </label>
            <select
              id="formation-select"
              class="w-full rounded-xl border border-white/10 bg-slate-950/60 px-3 py-2.5 text-sm text-slate-200 focus:border-emerald-500/50 focus:outline-none"
            >
              {FORMATIONS.map((f) => <option value={f.key}>{f.key}</option>)}
            </select>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <button
              type="button"
              id="undo-btn"
              disabled
              class="rounded-xl border border-white/10 px-3 py-2.5 text-sm font-medium text-slate-300 hover:bg-white/5 disabled:pointer-events-none disabled:opacity-40"
            >
              Deshacer
            </button>
            <button
              type="button"
              id="clear-team"
              data-confirming="false"
              class="rounded-xl border border-white/10 px-3 py-2.5 text-sm font-medium text-slate-300 hover:border-rose-500/40 hover:text-rose-300"
            >
              Vaciar equipo
            </button>
            <button
              type="button"
              id="lineup-new"
              class="rounded-xl border border-white/10 px-3 py-2.5 text-sm font-medium text-slate-300 hover:bg-white/5"
            >
              + Nueva convocatoria
            </button>
            <button
              type="button"
              id="lineup-delete"
              data-confirming="false"
              class="rounded-xl border border-white/10 px-3 py-2.5 text-sm font-medium text-slate-300 hover:border-rose-500/40 hover:text-rose-300 disabled:pointer-events-none disabled:opacity-40"
            >
              Eliminar
            </button>
          </div>
          <p class="text-xs text-slate-500">
            Tope de {formatMoney(MAX_BUDGET)} en precio Fantástica; el capitán debe
            costar menos de {formatMoney(MAX_CAPTAIN_PRICE)}.
          </p>
        </div>
      </details>
    </div>

    <div class="mt-2 flex items-center gap-3 text-sm">
      <span class="shrink-0 font-semibold text-white">
        <span id="budget-used">0,0</span><span class="text-slate-500"
          >&nbsp;/ 180 M€</span
        >
      </span>
      <div
        class="h-1.5 min-w-8 flex-1 overflow-hidden rounded-full bg-slate-800"
      >
        <div
          id="budget-bar"
          class="h-full w-0 rounded-full bg-emerald-500 transition-all"
        >
        </div>
      </div>
      <span id="sticky-changes" class="hidden shrink-0 font-semibold"></span>
      <span
        id="captain-status"
        class="max-w-28 shrink-0 truncate text-slate-400"></span>
    </div>
    <p id="budget-remaining" class="sr-only"></p>
  </div>

  <section
    id="pitch"
    aria-label="Tu 11"
    class="space-y-4 rounded-2xl border border-white/10 bg-gradient-to-b from-emerald-950/40 to-slate-900/60 px-2 py-4 sm:p-6"
  >
  </section>

  <ul id="warnings" class="mt-4 space-y-1.5 text-sm text-amber-300"></ul>

  <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-400">
    <span id="slots-status">0 / 11 jugadores</span>
    <span id="estimated-points"></span>
  </p>

  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4">
      <p
        class="mb-3 text-xs font-semibold tracking-wide text-slate-500 uppercase"
      >
        Rivales de la {nextGameweek.name}
      </p>
      <div id="rivals-summary" class="flex flex-wrap gap-3"></div>
    </div>
    <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4">
      <p
        class="mb-3 text-xs font-semibold tracking-wide text-slate-500 uppercase"
      >
        Equipos en tu 11
      </p>
      <div id="team-summary" class="flex flex-wrap gap-3"></div>
    </div>
  </div>

  <div
    id="sheet-backdrop"
    role="dialog"
    aria-modal="true"
    aria-labelledby="sheet-title"
    class="fixed inset-0 z-[70] hidden items-end justify-center bg-black/60 sm:items-center sm:p-4"
  >
    <div
      class="w-full max-w-md rounded-t-3xl border border-white/10 bg-slate-900 p-5 pb-[calc(1.25rem+env(safe-area-inset-bottom))] shadow-2xl sm:rounded-3xl sm:pb-5"
    >
      <div id="sheet-header" class="mb-4 flex items-center gap-3"></div>
      <div class="grid gap-2">
        <button
          type="button"
          data-sheet="change"
          class="rounded-xl bg-emerald-500 px-4 py-3.5 text-base font-semibold text-slate-950"
        >
          Cambiar jugador
        </button>
        <button
          type="button"
          data-sheet="captain"
          class="rounded-xl border border-amber-400/40 px-4 py-3.5 text-base font-semibold text-amber-300 disabled:border-white/10 disabled:text-slate-500"
        >
          Hacer capitán
        </button>
        <button
          type="button"
          data-sheet="remove"
          class="rounded-xl border border-white/10 px-4 py-3.5 text-base font-semibold text-rose-300"
        >
          Quitar del 11
        </button>
        <a
          data-sheet="profile"
          href={url("/jugadores")}
          class="rounded-xl border border-white/10 px-4 py-3.5 text-center text-base font-semibold text-slate-200"
        >
          Ver ficha
        </a>
        <button
          type="button"
          data-sheet="close"
          class="px-4 py-2 text-sm text-slate-400"
        >
          Cerrar
        </button>
      </div>
    </div>
  </div>

  <div
    id="picker-backdrop"
    role="dialog"
    aria-modal="true"
    aria-labelledby="picker-title"
    class="fixed inset-0 z-[70] hidden items-end justify-center bg-black/60 sm:items-center sm:p-4"
  >
    <div
      class="flex h-[92dvh] w-full max-w-lg flex-col rounded-t-3xl border border-white/10 bg-slate-900 p-4 shadow-2xl sm:h-auto sm:max-h-[85vh] sm:rounded-3xl"
    >
      <div class="mb-3 flex items-start justify-between gap-3">
        <div>
          <h2 id="picker-title" class="text-lg font-bold text-white">
            Elegir jugador
          </h2>
          <p id="picker-budget" class="text-sm text-slate-400"></p>
        </div>
        <button
          type="button"
          id="picker-close"
          aria-label="Cerrar"
          class="rounded-full p-2 text-slate-400 hover:bg-white/10 hover:text-white"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <input
        id="picker-search"
        type="search"
        placeholder="Buscar jugador o equipo..."
        aria-label="Buscar jugador"
        autocomplete="off"
        class="mb-3 w-full rounded-xl border border-white/10 bg-slate-950/60 px-3 py-2.5 text-base text-white placeholder:text-slate-500 focus:border-emerald-500/50 focus:outline-none"
      />
      <div class="mb-3 flex flex-wrap items-center gap-1.5">
        <div
          id="picker-sort"
          role="group"
          aria-label="Ordenar por"
          class="flex flex-wrap gap-1.5"
        >
          {
            [
              ["form", "Forma"],
              ["points", "Puntos"],
              ["value", "Pts/M€"],
              ["price", "Precio"],
            ].map(([key, label]) => (
              <button
                type="button"
                data-sort={key}
                aria-pressed={key === "form" ? "true" : "false"}
                class="rounded-full border border-white/10 px-3 py-1.5 text-sm font-medium text-slate-300 hover:bg-white/5 aria-pressed:border-emerald-500/40 aria-pressed:bg-emerald-500/10 aria-pressed:text-emerald-400"
              >
                {label}
              </button>
            ))
          }
        </div>
        <label
          class="ml-auto flex items-center gap-2 text-sm text-slate-300 select-none"
        >
          <input
            id="picker-affordable"
            type="checkbox"
            checked
            class="h-4 w-4 accent-emerald-500"
          />
          Solo los que caben
        </label>
      </div>
      <ul
        id="picker-list"
        class="-mx-1 min-h-0 flex-1 space-y-1 overflow-y-auto overscroll-contain"
      >
      </ul>
    </div>
  </div>

  <script
    define:vars={{
      players,
      FORMATIONS,
      DEFAULT_FORMATION,
      MAX_BUDGET,
      MAX_CAPTAIN_PRICE,
      POSITION_SHORT,
      PLAYER_STATUS_LABELS,
      TEAM_NEXT_OPPONENT,
      LIGA_ONCES,
      YO_STORAGE_KEY,
      YO_EVENT,
      NEXT_GW_NAME: nextGameweek.name,
      PLAYER_URL_BASE: url("/jugadores/"),
    }}
  >
    const playersById = new Map(players.map((p) => [p.id, p]));
    const LINEUPS_KEY = "fantasymarca:crear-once:lineups";
    const ACTIVE_KEY = "fantasymarca:crear-once:active";
    const LEGACY_KEY = "fantasymarca:crear-once";

    const POSITION_LABEL_LOWER = {
      1: "portero",
      2: "defensa",
      3: "centrocampista",
      4: "delantero",
    };

    const state = {
      formationKey: DEFAULT_FORMATION,
      slots: [],
      captainId: null,
    };
    let activeSlotId = null;
    let lastTrigger = null;
    let lastSnapshot = null;
    // Cambios permitidos entre jornada y jornada (3, 6 u 11): null cuando no
    // se está en modo cambios. Ver startChangesMode/computeChangesUsed.
    let changesMode = null;

    function formatMoneyClient(value) {
      return `${(value / 1_000_000).toFixed(2)} M€`;
    }

    // Descarta cualquier jugador guardado que ya no exista en el catálogo actual
    // (p.ej. si en una actualización de datos se queda sin precio Fantástica).
    function sanitizeSavedSlots(rawSlots) {
      if (!Array.isArray(rawSlots)) return [];
      return rawSlots
        .filter((s) => s && typeof s.position === "number")
        .map((s) => ({
          id: String(s.id ?? ""),
          position: s.position,
          playerId:
            typeof s.playerId === "number" && playersById.has(s.playerId)
              ? s.playerId
              : null,
        }));
    }

    // Valida un changesMode guardado (puede venir de localStorage corrupto o
    // de una convocatoria sin cambios activos).
    function sanitizeChangesMode(raw) {
      if (!raw || typeof raw.limit !== "number" || !raw.base) return null;
      if (!Array.isArray(raw.base.slots)) return null;
      return {
        limit: raw.limit,
        base: {
          formationKey:
            typeof raw.base.formationKey === "string"
              ? raw.base.formationKey
              : DEFAULT_FORMATION,
          slots: sanitizeSavedSlots(raw.base.slots),
          captainId:
            typeof raw.base.captainId === "number" ? raw.base.captainId : null,
        },
      };
    }

    // --- Convocatorias guardadas (varias onces, no solo una) ---------------

    function loadAllLineups() {
      try {
        const raw = localStorage.getItem(LINEUPS_KEY);
        if (raw) return JSON.parse(raw);
      } catch {
        // localStorage no disponible (modo privado, etc.)
      }
      // Migración desde la versión anterior, que solo guardaba un once bajo
      // LEGACY_KEY: se convierte en la primera convocatoria con nombre.
      try {
        const legacyRaw = localStorage.getItem(LEGACY_KEY);
        if (legacyRaw) {
          const legacy = JSON.parse(legacyRaw);
          localStorage.removeItem(LEGACY_KEY);
          return {
            [String(Date.now())]: {
              name: "Convocatoria 1",
              formationKey: legacy.formationKey,
              slots: legacy.slots,
              captainId: legacy.captainId,
            },
          };
        }
      } catch {
        // convocatoria legacy corrupta: se ignora
      }
      return {};
    }

    const lineups = loadAllLineups();

    function saveAllLineups() {
      try {
        localStorage.setItem(LINEUPS_KEY, JSON.stringify(lineups));
      } catch {
        // Modo privado, cuota llena, etc.: si no se puede guardar, se sigue usando la app sin más.
      }
    }

    function setActiveLineupId(id) {
      activeLineupId = id;
      try {
        localStorage.setItem(ACTIVE_KEY, id);
      } catch {
        // localStorage no disponible
      }
    }

    function ensureActiveLineup() {
      let id = null;
      try {
        id = localStorage.getItem(ACTIVE_KEY);
      } catch {
        // localStorage no disponible
      }
      if (id && lineups[id]) return id;
      const ids = Object.keys(lineups);
      if (ids.length > 0) return ids[0];
      const newId = String(Date.now());
      lineups[newId] = {
        name: "Convocatoria 1",
        formationKey: DEFAULT_FORMATION,
        slots: [],
        captainId: null,
      };
      return newId;
    }

    let activeLineupId = ensureActiveLineup();
    saveAllLineups();

    function applyLineup(id) {
      const lineup = lineups[id] ?? {
        formationKey: DEFAULT_FORMATION,
        slots: [],
        captainId: null,
      };
      state.formationKey = FORMATIONS.some((f) => f.key === lineup.formationKey)
        ? lineup.formationKey
        : DEFAULT_FORMATION;
      state.slots = buildSlots(
        state.formationKey,
        sanitizeSavedSlots(lineup.slots),
      );
      state.captainId =
        typeof lineup.captainId === "number" ? lineup.captainId : null;
      changesMode = sanitizeChangesMode(lineup.changesMode);
      lastSnapshot = null;
    }

    function saveState() {
      // teamIds va aparte (no solo playerId) para que otras páginas (el
      // calendario de la jornada) puedan saber qué equipos juegan sin tener
      // que cargar el catálogo completo de jugadores.
      const teamIds = [
        ...new Set(
          state.slots
            .filter((s) => s.playerId !== null)
            .map((s) => playersById.get(s.playerId).id_team),
        ),
      ];
      lineups[activeLineupId] = {
        name: lineups[activeLineupId]?.name ?? "Convocatoria",
        formationKey: state.formationKey,
        slots: state.slots,
        captainId: state.captainId,
        teamIds,
        changesMode,
      };
      saveAllLineups();
    }

    function buildSlots(formationKey, previousSlots) {
      const f = FORMATIONS.find((x) => x.key === formationKey);
      const counts = { 1: 1, 2: f.def, 3: f.mid, 4: f.fwd };
      const slots = [];
      for (const position of [1, 2, 3, 4]) {
        const carried = (previousSlots || []).filter(
          (s) => s.position === position,
        );
        for (let i = 0; i < counts[position]; i++) {
          slots.push({
            id: `${position}-${i}`,
            position,
            playerId: carried[i] ? carried[i].playerId : null,
          });
        }
      }
      return slots;
    }

    function usedIds(excludeSlotId) {
      return new Set(
        state.slots
          .filter((s) => s.playerId !== null && s.id !== excludeSlotId)
          .map((s) => s.playerId),
      );
    }

    function totalCost(excludeSlotId) {
      let total = 0;
      for (const slot of state.slots) {
        if (slot.id === excludeSlotId || slot.playerId === null) continue;
        total += playersById.get(slot.playerId).price;
      }
      return total;
    }

    const diacriticsPattern = new RegExp(
      `[${String.fromCharCode(0x0300)}-${String.fromCharCode(0x036f)}]`,
      "g",
    );

    function normalize(text) {
      return text.normalize("NFD").replace(diacriticsPattern, "").toLowerCase();
    }

    function formatMillions(value) {
      return `${(value / 1_000_000).toFixed(1).replace(".0", "")}M`;
    }

    // Ancho para que quepan 5 por línea en un móvil de 360px (gap-1.5 = 0.375rem).
    const CARD_WIDTH = "w-[calc((100%-1.5rem)/5)] max-w-[5.75rem]";

    function slotCard(slot) {
      const player =
        slot.playerId !== null ? playersById.get(slot.playerId) : null;
      const label = POSITION_SHORT[slot.position] ?? "?";
      const positionLower = POSITION_LABEL_LOWER[slot.position] ?? "jugador";

      if (!player) {
        return `
          <button type="button" data-slot="${slot.id}" data-action="open"
            aria-label="Elegir ${positionLower}"
            class="${CARD_WIDTH} flex aspect-[3/4] flex-col items-center justify-center gap-1 rounded-2xl border-2 border-dashed border-white/20 text-slate-400 transition-colors hover:border-emerald-500/50 hover:text-emerald-400">
            <span class="text-2xl leading-none">+</span>
            <span class="text-[11px] font-semibold uppercase tracking-wide">${label}</span>
          </button>`;
      }

      const isCaptain = state.captainId === player.id;
      const isNew = isNewInChangesMode(player.id);
      const noMatch = hasNoMatch(player);
      const rival = TEAM_NEXT_OPPONENT[player.id_team];
      const statusLabel = player.status
        ? (PLAYER_STATUS_LABELS[player.status] ?? "Baja")
        : "";
      const description = [
        player.name,
        isCaptain ? "capitán" : "",
        statusLabel.toLowerCase(),
        noMatch
          ? `no juega en la ${NEXT_GW_NAME}`
          : rival
            ? `contra ${rival.name}`
            : "",
        isNew ? "nuevo" : "",
      ]
        .filter(Boolean)
        .join(", ");

      return `
        <button type="button" data-slot="${slot.id}" data-action="sheet"
          aria-label="${description}"
          class="${CARD_WIDTH} relative flex flex-col items-center rounded-2xl border px-0.5 pt-2 pb-1.5 text-center transition-colors ${
            isNew
              ? "border-emerald-500/70 bg-emerald-500/15"
              : "border-white/10 bg-slate-900/90 hover:border-white/25"
          } ${noMatch ? "opacity-50" : ""}">
          ${isCaptain ? '<span class="absolute left-1 top-1 z-10 flex h-5 w-5 items-center justify-center rounded-full bg-amber-400 text-[11px] font-black text-slate-950">C</span>' : ""}
          <span class="relative block h-11 w-11">
            <img src="${player.photoUrl}" alt="" class="h-full w-full rounded-full bg-slate-800 object-cover" loading="lazy" />
            <img src="${player.teamLogoUrl}" alt="" class="absolute -bottom-0.5 -right-1 h-5 w-5 rounded-full bg-slate-950 p-0.5" />
            ${player.status ? '<span class="absolute -right-1 -top-1 flex h-4 w-4 items-center justify-center rounded-full bg-rose-500 text-[10px] font-black text-white ring-2 ring-slate-950">!</span>' : ""}
          </span>
          <span class="mt-1 block w-full truncate text-xs font-semibold leading-tight text-white">${player.shortName}</span>
          <span class="mt-0.5 flex items-center gap-1 text-[11px] leading-none text-slate-400">
            ${rival ? `<img src="${rival.logoUrl}" alt="" class="h-3.5 w-3.5" />` : noMatch ? "—" : ""}
            ${formatMillions(player.price)}
          </span>
        </button>`;
    }

    // Sin calendario cargado para la jornada no se puede saber quién juega:
    // en ese caso no se marca a nadie.
    const hasFixtures = Object.keys(TEAM_NEXT_OPPONENT).length > 0;

    function hasNoMatch(player) {
      return hasFixtures && !TEAM_NEXT_OPPONENT[player.id_team];
    }

    function renderWarnings() {
      const filled = state.slots
        .filter((s) => s.playerId !== null)
        .map((s) => playersById.get(s.playerId));
      const warnings = [];
      const noMatch = filled.filter(hasNoMatch);
      if (noMatch.length > 0) {
        warnings.push(
          `Sin partido en la ${NEXT_GW_NAME}: ${noMatch.map((p) => p.name).join(", ")}`,
        );
      }
      for (const p of filled.filter((p) => p.status)) {
        warnings.push(
          `${p.name}: ${(PLAYER_STATUS_LABELS[p.status] ?? "baja").toLowerCase()}`,
        );
      }
      if (totalCost(null) > MAX_BUDGET) {
        warnings.push("Te pasas del presupuesto de 180 M€");
      }
      if (changesMode && computeChangesUsed() > changesMode.limit) {
        warnings.push(
          `Llevas ${computeChangesUsed()} cambios y solo tienes ${changesMode.limit}`,
        );
      }
      if (filled.length === state.slots.length && state.captainId === null) {
        warnings.push("Falta elegir capitán");
      }
      document.getElementById("warnings").innerHTML = warnings
        .map((w) => `<li>⚠ ${w}</li>`)
        .join("");
    }

    const POSITION_ROWS = [
      { role: "Portero", position: 1 },
      { role: "Defensas", position: 2 },
      { role: "Centrocampistas", position: 3 },
      { role: "Delanteros", position: 4 },
    ];

    function renderTeamSummary() {
      const counts = new Map();
      for (const slot of state.slots) {
        if (slot.playerId === null) continue;
        const player = playersById.get(slot.playerId);
        const entry = counts.get(player.id_team) ?? {
          count: 0,
          teamName: player.teamName,
          teamLogoUrl: player.teamLogoUrl,
        };
        entry.count++;
        counts.set(player.id_team, entry);
      }
      const entries = Array.from(counts.values()).sort(
        (a, b) => b.count - a.count,
      );
      document.getElementById("team-summary").innerHTML =
        entries.length === 0
          ? `<p class="text-xs text-slate-500">Todavía no has fichado a nadie.</p>`
          : entries
              .map(
                (e) => `
            <div class="relative" title="${e.teamName}: ${e.count} jugador${e.count === 1 ? "" : "es"}">
              <img src="${e.teamLogoUrl}" alt="${e.teamName}" class="h-9 w-9 rounded-full bg-slate-800 object-contain p-1" />
              <span class="absolute -right-1 -bottom-1 flex h-4 w-4 items-center justify-center rounded-full bg-emerald-500 text-[10px] font-bold text-slate-950 ring-1 ring-slate-950">${e.count}</span>
            </div>`,
              )
              .join("");
    }

    function renderRivalsSummary() {
      const teamIds = new Set();
      for (const slot of state.slots) {
        if (slot.playerId === null) continue;
        teamIds.add(playersById.get(slot.playerId).id_team);
      }
      const container = document.getElementById("rivals-summary");
      if (teamIds.size === 0) {
        container.innerHTML = `<p class="text-xs text-slate-500">Todavía no has fichado a nadie.</p>`;
        return;
      }
      const rivals = Array.from(teamIds)
        .map((id) => TEAM_NEXT_OPPONENT[id])
        .filter(Boolean);
      container.innerHTML =
        rivals.length === 0
          ? `<p class="text-xs text-slate-500">Sin partidos programados todavía para esta jornada.</p>`
          : rivals
              .map(
                (r) => `
            <div title="Rival: ${r.name}">
              <img src="${r.logoUrl}" alt="${r.name}" class="h-9 w-9 rounded-full bg-slate-800 object-contain p-1" />
            </div>`,
              )
              .join("");
    }

    // Estimación simple hasta tener puntos esperados por partido: media de
    // puntos de esta temporada de cada titular, con el capitán doblado.
    function renderEstimatedPoints() {
      const filled = state.slots
        .filter((s) => s.playerId !== null)
        .map((s) => playersById.get(s.playerId));
      const label = document.getElementById("estimated-points");
      if (filled.length === 0) {
        label.textContent = "";
        return;
      }
      const total = filled.reduce(
        (sum, p) => sum + p.avg * (p.id === state.captainId ? 2 : 1),
        0,
      );
      label.textContent = `≈ ${total.toFixed(0)} pts esperados (media de la temporada)`;
    }

    // --- Cambios entre jornada y jornada (3, 6 u 11) ------------------------
    // "changesMode.base" es el once tal cual estaba al pulsar el número de
    // cambios: se compara por jugador (no por hueco) para que un cambio de
    // formación a mitad de sesión no rompa la cuenta.

    const CHANGE_LIMIT_OPTIONS = [3, 6, 11];

    function computeChangesUsed() {
      if (!changesMode) return 0;
      const baseIds = changesMode.base.slots
        .filter((s) => s.playerId !== null)
        .map((s) => s.playerId);
      const currentIds = new Set(
        state.slots.filter((s) => s.playerId !== null).map((s) => s.playerId),
      );
      return baseIds.filter((id) => !currentIds.has(id)).length;
    }

    // Empareja cada jugador que sale con uno que entra (por orden de
    // aparición) para el mensaje de WhatsApp: "jugador viejo - jugador nuevo".
    function computeChangesDiff() {
      if (!changesMode) return [];
      const baseIds = changesMode.base.slots
        .filter((s) => s.playerId !== null)
        .map((s) => s.playerId);
      const currentIds = state.slots
        .filter((s) => s.playerId !== null)
        .map((s) => s.playerId);
      const baseSet = new Set(baseIds);
      const currentSet = new Set(currentIds);
      const removed = baseIds.filter((id) => !currentSet.has(id));
      const added = currentIds.filter((id) => !baseSet.has(id));
      const pairs = [];
      for (let i = 0; i < Math.max(removed.length, added.length); i++) {
        pairs.push({ out: removed[i] ?? null, in: added[i] ?? null });
      }
      return pairs;
    }

    function isNewInChangesMode(playerId) {
      if (!changesMode) return false;
      return !changesMode.base.slots.some((s) => s.playerId === playerId);
    }

    function startChangesMode(limit) {
      changesMode = {
        limit,
        base: {
          formationKey: state.formationKey,
          slots: state.slots.map((s) => ({ ...s })),
          captainId: state.captainId,
        },
      };
      render();
    }

    // Deshace toda la sesión de cambios, no solo el último: vuelve al once
    // exacto de antes de pulsar 3/6/11 cambios. Es destructivo (no pasa por
    // el "Deshacer" general) así que el propio botón pide confirmación, igual
    // que "Vaciar equipo".
    function cancelChangesMode() {
      if (!changesMode) return;
      state.formationKey = changesMode.base.formationKey;
      state.slots = buildSlots(state.formationKey, changesMode.base.slots);
      state.captainId = changesMode.base.captainId;
      changesMode = null;
      lastSnapshot = null;
      updateUndoButton();
      render();
    }

    // Cierra la sesión de cambios pero mantiene el once actual (queda listo
    // para la siguiente jornada, cuando se vuelva a pulsar 3/6/11 cambios).
    function finishChangesMode() {
      changesMode = null;
      render();
    }

    // Solo se reconstruyen los botones cuando se entra o se sale del modo
    // cambios (cambia la estructura); mientras se está dentro, cada edición
    // actualiza solo el número del contador — si no, quien navegue por
    // teclado perdería el foco en "Cancelar cambios" con cada ficha que mueva.
    let changesPanelMode = null;

    function renderChangesPanelStructure() {
      const container = document.getElementById("changes-panel");
      if (!changesMode) {
        container.innerHTML = `
          <div role="group" aria-label="Cambios permitidos" class="flex flex-wrap items-center gap-2">
            ${CHANGE_LIMIT_OPTIONS.map(
              (n) => `
              <button type="button" data-changes-limit="${n}"
                class="rounded-xl border border-white/10 px-3 py-2.5 text-sm font-medium text-slate-300 transition-colors hover:bg-white/5 hover:text-white">
                ${n} cambios
              </button>`,
            ).join("")}
          </div>
          <p class="mt-2 text-xs text-slate-500">
            Elige cuántos cambios puedes hacer respecto al once de la jornada
            pasada — se guarda el once actual como punto de partida.
          </p>`;
        changesPanelMode = "idle";
        return;
      }
      container.innerHTML = `
        <div class="flex flex-wrap items-center justify-between gap-3">
          <span id="changes-counter" class="text-sm font-medium text-white">
            Cambios: 0 / ${changesMode.limit}
          </span>
          <div class="flex gap-2">
            <button type="button" id="changes-cancel" data-confirming="false"
              class="rounded-full border border-white/10 px-3 py-1.5 text-xs font-medium text-slate-400 transition-colors hover:border-rose-500/40 hover:text-rose-300">
              Cancelar cambios
            </button>
            <button type="button" id="changes-finish"
              class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1.5 text-xs font-medium text-emerald-400 transition-colors hover:bg-emerald-500/20">
              Terminar cambios
            </button>
          </div>
        </div>
        <p class="mt-2 text-xs text-slate-500">
          Los jugadores nuevos respecto al once de la jornada pasada aparecen
          marcados en verde en el campo.
        </p>`;
      changesPanelMode = "active";
      updateChangesCounter();
    }

    function updateChangesCounter() {
      if (!changesMode) return;
      const counter = document.getElementById("changes-counter");
      if (!counter) return;
      const used = computeChangesUsed();
      const overLimit = used > changesMode.limit;
      counter.textContent = `Cambios: ${used} / ${changesMode.limit}`;
      counter.className = `text-sm font-medium ${overLimit ? "text-rose-400" : "text-white"}`;
    }

    function renderChangesPanel() {
      const desiredMode = changesMode ? "active" : "idle";
      if (desiredMode !== changesPanelMode) renderChangesPanelStructure();
      else updateChangesCounter();
    }

    let cancelChangesTimer = null;

    function resetCancelChangesButton() {
      const btn = document.getElementById("changes-cancel");
      if (!btn) return;
      if (cancelChangesTimer) clearTimeout(cancelChangesTimer);
      cancelChangesTimer = null;
      btn.dataset.confirming = "false";
      btn.textContent = "Cancelar cambios";
      btn.classList.remove(
        "border-rose-500/60",
        "bg-rose-500/10",
        "text-rose-300",
      );
    }

    document.getElementById("changes-panel").addEventListener("click", (e) => {
      const limitBtn = e.target.closest("[data-changes-limit]");
      if (limitBtn) {
        startChangesMode(Number(limitBtn.dataset.changesLimit));
        return;
      }
      const cancelBtn = e.target.closest("#changes-cancel");
      if (cancelBtn) {
        if (cancelBtn.dataset.confirming === "true") {
          resetCancelChangesButton();
          cancelChangesMode();
          return;
        }
        cancelBtn.dataset.confirming = "true";
        cancelBtn.textContent = "¿Seguro? Confirmar";
        cancelBtn.classList.add(
          "border-rose-500/60",
          "bg-rose-500/10",
          "text-rose-300",
        );
        cancelChangesTimer = setTimeout(resetCancelChangesButton, 3000);
        return;
      }
      if (e.target.closest("#changes-finish")) {
        finishChangesMode();
      }
    });
    // `blur` no burbujea; `focusout` sí, así que es lo único que funciona
    // con un botón que se recrea dinámicamente en vez de existir siempre.
    document
      .getElementById("changes-panel")
      .addEventListener("focusout", (e) => {
        if (e.target.id === "changes-cancel") resetCancelChangesButton();
      });

    function render() {
      // el capitán tiene que seguir en el 11 y seguir siendo elegible
      if (state.captainId !== null) {
        const stillIn = state.slots.some((s) => s.playerId === state.captainId);
        const player = playersById.get(state.captainId);
        if (!stillIn || !player || player.price >= MAX_CAPTAIN_PRICE) {
          state.captainId = null;
        }
      }

      const rows = POSITION_ROWS;

      const pitch = document.getElementById("pitch");
      pitch.innerHTML = rows
        .map((row) => {
          const slots = state.slots.filter((s) => s.position === row.position);
          return `
            <div role="group" aria-label="${row.role}" class="flex justify-center gap-1.5">
              ${slots.map(slotCard).join("")}
            </div>`;
        })
        .join("");

      const filled = state.slots.filter((s) => s.playerId !== null);
      const cost = totalCost(null);
      const pct = Math.min(100, (cost / MAX_BUDGET) * 100);
      const overBudget = cost > MAX_BUDGET;

      const budgetUsed = document.getElementById("budget-used");
      budgetUsed.textContent = (cost / 1_000_000).toFixed(1).replace(".", ",");
      budgetUsed.className = overBudget ? "text-rose-400" : "";
      document.getElementById("budget-remaining").textContent = overBudget
        ? `Superado por ${formatMoneyClient(cost - MAX_BUDGET)}`
        : `Quedan ${formatMoneyClient(MAX_BUDGET - cost)} disponibles`;
      document.getElementById("budget-remaining").className = "sr-only";

      const bar = document.getElementById("budget-bar");
      bar.style.width = `${pct}%`;
      bar.className = `h-full rounded-full transition-all ${overBudget ? "bg-rose-500" : "bg-emerald-500"}`;

      document.getElementById("slots-status").textContent =
        `${filled.length} / ${state.slots.length} jugadores`;

      const captainStatus = document.getElementById("captain-status");
      captainStatus.textContent = state.captainId
        ? `C: ${playersById.get(state.captainId).shortName}`
        : "Sin capitán";
      captainStatus.className = `max-w-28 shrink-0 truncate ${
        state.captainId ? "text-amber-300" : "text-slate-500"
      }`;

      const stickyChanges = document.getElementById("sticky-changes");
      if (changesMode) {
        const used = computeChangesUsed();
        stickyChanges.textContent = `${used}/${changesMode.limit} cambios`;
        stickyChanges.className = `shrink-0 font-semibold ${
          used > changesMode.limit ? "text-rose-400" : "text-emerald-400"
        }`;
      } else {
        stickyChanges.className = "hidden";
      }

      document.getElementById("formation-select").value = state.formationKey;

      document.getElementById("share-whatsapp").disabled = filled.length === 0;

      renderTeamSummary();
      renderRivalsSummary();
      renderEstimatedPoints();
      renderChangesPanel();
      renderWarnings();

      saveState();
      renderLigaPanel();
    }

    function snapshotForUndo() {
      lastSnapshot = {
        formationKey: state.formationKey,
        slots: state.slots.map((s) => ({ ...s })),
        captainId: state.captainId,
      };
      updateUndoButton();
    }

    function updateUndoButton() {
      document.getElementById("undo-btn").disabled = lastSnapshot === null;
    }

    // Mientras un panel (selector o acciones de jugador) está abierto, el
    // resto de la página se marca `inert`: así ni el ratón ni Tab llegan al
    // fondo (sin reimplementar un trap de foco) y un lector de pantalla deja
    // de verlo. Se recorren los hijos de <body> para cubrir todo lo que haya.
    function setBackgroundInert(isInert, backdrop) {
      for (const child of document.body.children) {
        if (backdrop && child.contains(backdrop)) {
          for (const grandchild of child.children) {
            if (grandchild === backdrop) continue;
            if (isInert) grandchild.setAttribute("inert", "");
            else grandchild.removeAttribute("inert");
          }
        } else if (isInert) {
          child.setAttribute("inert", "");
        } else {
          child.removeAttribute("inert");
        }
      }
    }

    function showBackdrop(id) {
      const backdrop = document.getElementById(id);
      backdrop.classList.remove("hidden");
      backdrop.classList.add("flex");
      setBackgroundInert(true, backdrop);
      return backdrop;
    }

    function hideBackdrop(id) {
      const backdrop = document.getElementById(id);
      if (backdrop.classList.contains("hidden")) return false;
      backdrop.classList.add("hidden");
      backdrop.classList.remove("flex");
      setBackgroundInert(false, backdrop);
      return true;
    }

    // En el móvil, abrir el teclado nada más abrir el selector tapa la lista.
    const finePointer = window.matchMedia("(pointer: fine)").matches;

    function openPicker(slotId, triggerEl) {
      activeSlotId = slotId;
      lastTrigger = triggerEl ?? lastTrigger ?? null;
      const slot = state.slots.find((s) => s.id === slotId);
      const label = POSITION_LABEL_LOWER[slot.position] ?? "jugador";
      const current =
        slot.playerId !== null ? playersById.get(slot.playerId) : null;
      document.getElementById("picker-title").textContent = current
        ? `Cambiar a ${current.shortName}`
        : `Elegir ${label}`;
      document.getElementById("picker-search").value = "";
      renderPickerList("");
      showBackdrop("picker-backdrop");
      document.getElementById("picker-list").scrollTop = 0;
      if (finePointer) document.getElementById("picker-search").focus();
    }

    function closePicker() {
      if (!hideBackdrop("picker-backdrop")) return;
      activeSlotId = null;
      lastTrigger?.focus();
      lastTrigger = null;
    }

    // --- Acciones de un jugador del campo (panel desde abajo) --------------

    let sheetSlotId = null;

    function openSheet(slotId, triggerEl) {
      const slot = state.slots.find((s) => s.id === slotId);
      const player = playersById.get(slot.playerId);
      if (!player) return;
      sheetSlotId = slotId;
      lastTrigger = triggerEl ?? null;
      const rival = TEAM_NEXT_OPPONENT[player.id_team];
      const status = player.status
        ? `<span class="text-rose-300">${PLAYER_STATUS_LABELS[player.status] ?? "Baja"}</span> · `
        : "";
      document.getElementById("sheet-header").innerHTML = `
        <img src="${player.photoUrl}" alt="" class="h-14 w-14 shrink-0 rounded-full bg-slate-800 object-cover" />
        <div class="min-w-0">
          <p id="sheet-title" class="truncate text-lg font-bold text-white">${player.name}</p>
          <p class="text-sm text-slate-400">${status}${player.teamName} · ${formatMoneyClient(player.price)}</p>
          <p class="text-sm text-slate-400">
            ${rival ? `Rival: ${rival.name}` : `Sin partido en la ${NEXT_GW_NAME}`}
            · J anterior: ${player.lastGwPoints ?? "–"} pts · forma ${player.form}
          </p>
        </div>`;
      const isCaptain = state.captainId === player.id;
      const eligible = player.price < MAX_CAPTAIN_PRICE;
      const captainBtn = document.querySelector('[data-sheet="captain"]');
      captainBtn.disabled = !isCaptain && !eligible;
      captainBtn.textContent = isCaptain
        ? "Quitar capitán"
        : eligible
          ? "Hacer capitán"
          : `No puede ser capitán (cuesta ${formatMillions(MAX_CAPTAIN_PRICE)} o más)`;
      document.querySelector('[data-sheet="profile"]').href =
        `${PLAYER_URL_BASE}${player.id}/`;
      showBackdrop("sheet-backdrop");
      document.querySelector('[data-sheet="change"]').focus();
    }

    function closeSheet(restoreFocus = true) {
      if (!hideBackdrop("sheet-backdrop")) return;
      sheetSlotId = null;
      if (restoreFocus) {
        lastTrigger?.focus();
        lastTrigger = null;
      }
    }

    document.getElementById("sheet-backdrop").addEventListener("click", (e) => {
      if (e.target.id === "sheet-backdrop") {
        closeSheet();
        return;
      }
      const btn = e.target.closest("[data-sheet]");
      if (!btn || sheetSlotId === null) return;
      const slot = state.slots.find((s) => s.id === sheetSlotId);
      const action = btn.dataset.sheet;
      if (action === "profile") return; // enlace normal
      if (action === "close") {
        closeSheet();
      } else if (action === "change") {
        const slotId = sheetSlotId;
        closeSheet(false);
        openPicker(slotId);
      } else if (action === "captain") {
        state.captainId =
          state.captainId === slot.playerId ? null : slot.playerId;
        closeSheet();
        render();
      } else if (action === "remove") {
        snapshotForUndo();
        if (state.captainId === slot.playerId) state.captainId = null;
        slot.playerId = null;
        closeSheet(false);
        lastTrigger = null;
        render();
      }
    });

    let pickerSort = "form";
    const PICKER_SORTS = {
      price: (p) => p.price,
      points: (p) => p.points,
      form: (p) => p.form,
      value: (p) => p.points / (p.price / 1_000_000),
    };

    function renderPickerList(query) {
      const slot = state.slots.find((s) => s.id === activeSlotId);
      const used = usedIds(activeSlotId);
      const remaining = MAX_BUDGET - totalCost(activeSlotId);
      const onlyAffordable =
        document.getElementById("picker-affordable").checked;
      const q = normalize(query.trim());
      const sortKey = PICKER_SORTS[pickerSort];

      document.getElementById("picker-budget").textContent =
        remaining >= 0
          ? `Te caben jugadores de hasta ${formatMillions(remaining)}`
          : `Te pasas del presupuesto en ${formatMillions(-remaining)}`;

      const candidates = players
        .filter((p) => p.position === slot.position && !used.has(p.id))
        .filter(
          (p) =>
            !q ||
            normalize(p.name).includes(q) ||
            normalize(p.teamName).includes(q),
        )
        .filter(
          (p) =>
            !onlyAffordable || p.price <= remaining || p.id === slot.playerId,
        )
        .sort((a, b) => sortKey(b) - sortKey(a) || b.price - a.price);

      const list = document.getElementById("picker-list");
      if (candidates.length === 0) {
        list.innerHTML = `<li class="p-6 text-center text-sm text-slate-500">Sin resultados${onlyAffordable ? " que quepan en tu presupuesto" : ""}.</li>`;
        return;
      }

      list.innerHTML = candidates
        .map((p) => {
          const affordable = p.price <= remaining || p.id === slot.playerId;
          const rival = TEAM_NEXT_OPPONENT[p.id_team];
          const isCurrent = p.id === slot.playerId;
          return `
            <li>
              <button type="button" data-pick="${p.id}" ${affordable ? "" : "disabled"}
                class="flex w-full items-center gap-3 rounded-xl px-2 py-2.5 text-left ${
                  isCurrent ? "bg-emerald-500/10" : ""
                } ${affordable ? "hover:bg-white/5" : "cursor-not-allowed opacity-40"}">
                <span class="relative h-11 w-11 shrink-0">
                  <img src="${p.photoUrl}" alt="" class="h-full w-full rounded-full bg-slate-800 object-cover" loading="lazy" />
                  ${
                    p.status
                      ? `<span class="absolute -right-1 -top-1 flex h-4 w-4 items-center justify-center rounded-full bg-rose-500 text-[10px] font-black text-white ring-2 ring-slate-900" title="${PLAYER_STATUS_LABELS[p.status] ?? "Baja"}" aria-label="${PLAYER_STATUS_LABELS[p.status] ?? "Baja"}">!</span>`
                      : ""
                  }
                </span>
                <span class="min-w-0 flex-1">
                  <span class="flex items-baseline justify-between gap-2">
                    <span class="truncate text-[15px] font-semibold text-white">${p.name}</span>
                    <span class="shrink-0 text-[15px] font-semibold ${affordable ? "text-emerald-400" : "text-rose-400"}">${formatMillions(p.price)}</span>
                  </span>
                  <span class="mt-0.5 flex items-center gap-1.5 text-[13px] text-slate-400">
                    ${
                      rival
                        ? `<img src="${rival.logoUrl}" alt="" class="h-4 w-4 shrink-0" /><span class="truncate">vs ${rival.name}</span>`
                        : `<span class="text-amber-400">sin partido</span>`
                    }
                  </span>
                  <span class="mt-0.5 block text-[13px] text-slate-400">
                    Forma <b class="text-slate-200">${p.form}</b> · ${p.points} pts · ${p.ownershipPct}% liga
                  </span>
                </span>
              </button>
            </li>`;
        })
        .join("");
    }

    document
      .getElementById("formation-select")
      .addEventListener("change", (e) => {
        snapshotForUndo();
        state.slots = buildSlots(e.target.value, state.slots);
        state.formationKey = e.target.value;
        render();
      });

    document.getElementById("pitch").addEventListener("click", (e) => {
      const btn = e.target.closest("button[data-slot]");
      if (!btn) return;
      const slot = state.slots.find((s) => s.id === btn.dataset.slot);
      if (btn.dataset.action === "open") openPicker(slot.id, btn);
      else if (btn.dataset.action === "sheet") openSheet(slot.id, btn);
    });

    document.getElementById("picker-list").addEventListener("click", (e) => {
      const btn = e.target.closest("button[data-pick]");
      if (!btn || btn.disabled) return;
      const slot = state.slots.find((s) => s.id === activeSlotId);
      snapshotForUndo();
      slot.playerId = Number(btn.dataset.pick);
      closePicker();
      render();
    });

    document.getElementById("picker-search").addEventListener("input", (e) => {
      renderPickerList(e.target.value);
    });

    document
      .getElementById("picker-affordable")
      .addEventListener("change", () =>
        renderPickerList(document.getElementById("picker-search").value),
      );

    document.getElementById("picker-sort").addEventListener("click", (e) => {
      const btn = e.target.closest("[data-sort]");
      if (!btn) return;
      pickerSort = btn.dataset.sort;
      for (const b of document.querySelectorAll("#picker-sort [data-sort]")) {
        b.setAttribute("aria-pressed", String(b === btn));
      }
      renderPickerList(document.getElementById("picker-search").value);
    });

    document
      .getElementById("picker-close")
      .addEventListener("click", closePicker);
    document
      .getElementById("picker-backdrop")
      .addEventListener("click", (e) => {
        if (e.target.id === "picker-backdrop") closePicker();
      });
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      closePicker();
      closeSheet();
    });

    // El menú ⋯ se cierra al tocar fuera de él.
    const onceMenu = document.getElementById("once-menu");
    document.addEventListener("click", (e) => {
      if (onceMenu.open && !onceMenu.contains(e.target)) onceMenu.open = false;
    });

    document.getElementById("undo-btn").addEventListener("click", () => {
      if (!lastSnapshot) return;
      state.formationKey = lastSnapshot.formationKey;
      state.slots = lastSnapshot.slots;
      state.captainId = lastSnapshot.captainId;
      lastSnapshot = null;
      updateUndoButton();
      render();
    });

    const clearTeamBtn = document.getElementById("clear-team");
    let clearConfirmTimer = null;

    function resetClearTeamButton() {
      if (clearConfirmTimer) clearTimeout(clearConfirmTimer);
      clearConfirmTimer = null;
      clearTeamBtn.dataset.confirming = "false";
      clearTeamBtn.textContent = "Vaciar equipo";
      clearTeamBtn.classList.remove(
        "border-rose-500/60",
        "bg-rose-500/10",
        "text-rose-300",
      );
    }

    // En vez de un confirm() nativo (que desentona con el resto de la UI),
    // el propio botón pide confirmación: un segundo clic en los próximos 3s
    // vacía el equipo, si no, vuelve solo a su estado normal.
    clearTeamBtn.addEventListener("click", () => {
      if (clearTeamBtn.dataset.confirming === "true") {
        resetClearTeamButton();
        snapshotForUndo();
        state.captainId = null;
        state.slots = buildSlots(state.formationKey, []);
        render();
        return;
      }
      clearTeamBtn.dataset.confirming = "true";
      clearTeamBtn.textContent = "¿Seguro? Confirmar";
      clearTeamBtn.classList.add(
        "border-rose-500/60",
        "bg-rose-500/10",
        "text-rose-300",
      );
      clearConfirmTimer = setTimeout(resetClearTeamButton, 3000);
    });
    clearTeamBtn.addEventListener("blur", resetClearTeamButton);

    // --- Selector de convocatorias -----------------------------------------

    const lineupSelect = document.getElementById("lineup-select");
    const lineupNewBtn = document.getElementById("lineup-new");
    const lineupDeleteBtn = document.getElementById("lineup-delete");

    function renderLineupSelect() {
      const ids = Object.keys(lineups);
      lineupSelect.innerHTML = ids
        .map(
          (id) =>
            `<option value="${id}" ${id === activeLineupId ? "selected" : ""}>${lineups[id].name}</option>`,
        )
        .join("");
      lineupDeleteBtn.disabled = ids.length <= 1;
    }

    lineupSelect.addEventListener("change", () => {
      setActiveLineupId(lineupSelect.value);
      applyLineup(activeLineupId);
      updateUndoButton();
      render();
    });

    lineupNewBtn.addEventListener("click", () => {
      const id = String(Date.now());
      lineups[id] = {
        name: `Convocatoria ${Object.keys(lineups).length + 1}`,
        formationKey: DEFAULT_FORMATION,
        slots: [],
        captainId: null,
      };
      saveAllLineups();
      setActiveLineupId(id);
      applyLineup(activeLineupId);
      renderLineupSelect();
      updateUndoButton();
      render();
    });

    let deleteLineupTimer = null;

    function resetDeleteLineupButton() {
      if (deleteLineupTimer) clearTimeout(deleteLineupTimer);
      deleteLineupTimer = null;
      lineupDeleteBtn.dataset.confirming = "false";
      lineupDeleteBtn.textContent = "Eliminar";
      lineupDeleteBtn.classList.remove(
        "border-rose-500/60",
        "bg-rose-500/10",
        "text-rose-300",
      );
    }

    lineupDeleteBtn.addEventListener("click", () => {
      if (Object.keys(lineups).length <= 1) return;
      if (lineupDeleteBtn.dataset.confirming === "true") {
        resetDeleteLineupButton();
        delete lineups[activeLineupId];
        saveAllLineups();
        setActiveLineupId(Object.keys(lineups)[0]);
        applyLineup(activeLineupId);
        renderLineupSelect();
        updateUndoButton();
        render();
        return;
      }
      lineupDeleteBtn.dataset.confirming = "true";
      lineupDeleteBtn.textContent = "¿Seguro? Confirmar";
      lineupDeleteBtn.classList.add(
        "border-rose-500/60",
        "bg-rose-500/10",
        "text-rose-300",
      );
      deleteLineupTimer = setTimeout(resetDeleteLineupButton, 3000);
    });
    lineupDeleteBtn.addEventListener("blur", resetDeleteLineupButton);

    function showNotice(message) {
      const el = document.getElementById("page-notice");
      el.textContent = message;
      el.classList.remove("hidden");
    }

    // Con cambios activos, el mensaje muestra solo las sustituciones (formato
    // que pide la liga: "jugador viejo - jugador nuevo") en vez del once
    // completo agrupado por puesto.
    function buildWhatsAppMessage() {
      if (changesMode) {
        const lines = computeChangesDiff().map(({ out, in: inId }) => {
          const outName = out !== null ? playersById.get(out).name : "—";
          const inName = inId !== null ? playersById.get(inId).name : "—";
          return `${outName} - ${inName}`;
        });
        if (state.captainId !== null) {
          lines.push(`${playersById.get(state.captainId).name} (c)`);
        }
        return lines.join("\n");
      }

      const groups = POSITION_ROWS.map((row) => {
        const names = state.slots
          .filter((s) => s.position === row.position && s.playerId !== null)
          .map((s) => {
            const player = playersById.get(s.playerId);
            return state.captainId === player.id
              ? `${player.name} (c)`
              : player.name;
          });
        return { role: row.role, names };
      }).filter((g) => g.names.length > 0);

      return groups
        .map((g) => `*${g.role}*\n${g.names.join("\n")}`)
        .join("\n\n");
    }

    document.getElementById("share-whatsapp").addEventListener("click", () => {
      // El botón ya se deshabilita en render() cuando no hay jugadores; esto
      // es solo una salvaguarda.
      const filled = state.slots.filter((s) => s.playerId !== null);
      if (filled.length === 0) return;
      const text = buildWhatsAppMessage();
      if (!text.trim()) {
        showNotice(
          "Todavía no hay cambios que compartir: mueve algún jugador primero.",
        );
        return;
      }
      window.open(
        `https://wa.me/?text=${encodeURIComponent(text)}`,
        "_blank",
        "noopener",
      );
    });

    // Llegada desde el botón "Añadir a mi once" de la ficha de un jugador
    // (jugadores/[id].astro), vía ?add=<id>.
    function tryAddPlayerFromQuery() {
      const params = new URLSearchParams(window.location.search);
      const addId = params.get("add");
      if (!addId) return;
      // Se limpia el parámetro de la URL para que un simple refresco no repita la acción.
      window.history.replaceState(null, "", window.location.pathname);

      const player = playersById.get(Number(addId));
      if (!player) {
        showNotice(
          "Ese jugador no tiene precio Fantástica todavía y no se puede fichar.",
        );
        return;
      }
      const freeSlot = state.slots.find(
        (s) => s.position === player.position && s.playerId === null,
      );
      if (!freeSlot) {
        const positionLower =
          POSITION_LABEL_LOWER[player.position] ?? "esa posición";
        showNotice(
          `Ya tienes completos los puestos de ${positionLower}. Quita a alguien antes de fichar a ${player.name}.`,
        );
        return;
      }
      const remaining = MAX_BUDGET - totalCost(null);
      if (player.price > remaining) {
        showNotice(
          `Fichar a ${player.name} (${formatMoneyClient(player.price)}) superaría tu presupuesto de ${formatMoneyClient(MAX_BUDGET)}.`,
        );
        return;
      }
      snapshotForUndo();
      freeSlot.playerId = player.id;
      render();
    }

    // --- Once de la liga (quién eres + última jornada de los PDFs) ---------

    function currentYo() {
      try {
        const value = localStorage.getItem(YO_STORAGE_KEY);
        return LIGA_ONCES[value] ? value : null;
      } catch {
        return null;
      }
    }

    function ligaLineupId(yo) {
      return `liga-${yo}-${LIGA_ONCES[yo].jornada}`;
    }

    function renderLigaPanel() {
      const panel = document.getElementById("liga-panel");
      const yo = currentYo();
      if (!yo) {
        panel.classList.add("hidden");
        return;
      }
      const once = LIGA_ONCES[yo];
      panel.classList.remove("hidden");
      if (activeLineupId === ligaLineupId(yo)) {
        panel.innerHTML = `
          <p class="text-sm text-slate-300">
            Partes de tu once de la <strong class="text-white">Jornada ${once.jornada}</strong>.
            Tienes <strong class="text-emerald-400">${once.changes} cambios</strong> para la ${NEXT_GW_NAME};
            los que hagas salen en verde y se cuentan arriba.
          </p>`;
        return;
      }
      panel.innerHTML = `
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="text-sm text-slate-300">
            ${yo}, tienes <strong class="text-emerald-400">${once.changes} cambios</strong>
            para la ${NEXT_GW_NAME}.
          </p>
          <button type="button" id="liga-load"
            class="rounded-full bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-emerald-400">
            Cargar mi once de la Jornada ${once.jornada}
          </button>
        </div>`;
    }

    // La convocatoria de la liga tiene id fijo por persona y jornada: si ya
    // existe se vuelve a ella con los cambios que llevaras, no se pisa.
    function loadLigaLineup(yo) {
      const once = LIGA_ONCES[yo];
      const id = ligaLineupId(yo);
      if (!lineups[id]) {
        const slots = buildSlots(once.formationKey, once.slots);
        lineups[id] = {
          name: `${yo} · ${NEXT_GW_NAME}`,
          formationKey: once.formationKey,
          slots,
          captainId: once.captainId,
          changesMode: {
            limit: once.changes,
            base: {
              formationKey: once.formationKey,
              slots: slots.map((s) => ({ ...s })),
              captainId: once.captainId,
            },
          },
        };
        saveAllLineups();
      }
      setActiveLineupId(id);
      applyLineup(id);
      renderLineupSelect();
      updateUndoButton();
      render();
      if (once.missing.length > 0) {
        showNotice(
          `Sin precio Fantástica, no se han podido cargar: ${once.missing.join(", ")}. Elige sustituto en su hueco.`,
        );
      }
    }

    document.getElementById("liga-panel").addEventListener("click", (e) => {
      const yo = currentYo();
      if (yo && e.target.closest("#liga-load")) loadLigaLineup(yo);
    });

    window.addEventListener(YO_EVENT, renderLigaPanel);

    // Llegada desde "Preparar mi once" de la home, vía ?liga=1.
    function tryLoadLigaFromQuery() {
      const params = new URLSearchParams(window.location.search);
      if (!params.has("liga")) return;
      window.history.replaceState(null, "", window.location.pathname);
      const yo = currentYo();
      if (yo) loadLigaLineup(yo);
      else
        showNotice(
          "Elige quién eres arriba (¿Quién eres?) para cargar tu once de la liga.",
        );
    }

    renderLineupSelect();
    applyLineup(activeLineupId);
    tryAddPlayerFromQuery();
    updateUndoButton();
    render();
    tryLoadLigaFromQuery();
  </script>
</Layout>
