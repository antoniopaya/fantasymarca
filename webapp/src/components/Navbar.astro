---
import Icon from "./Icon.astro";
import { url } from "../lib/data";
import { FAMILIA } from "../lib/yo";

// Las 5 secciones, en el orden de uso semanal: arriba en escritorio, como
// barra de pestañas abajo en el móvil (como una app).
const navItems = [
  {
    href: url("/"),
    label: "Inicio",
    match: ["/"],
    icon: "home" as const,
  },
  {
    href: url("/crear-once"),
    label: "Mi 11",
    match: ["/crear-once"],
    icon: "field" as const,
  },
  {
    href: url("/jugadores"),
    label: "Jugadores",
    match: ["/jugadores", "/estadisticas"],
    icon: "users" as const,
  },
  {
    href: url("/jornada"),
    label: "Jornada",
    match: ["/jornada"],
    icon: "calendar" as const,
  },
  {
    href: url("/liga"),
    label: "Liga",
    match: ["/liga"],
    icon: "trophy" as const,
  },
];

// No fiarse de si Astro.url.pathname incluye o no el `base` configurado (varía
// entre dev/build): se le quita a mano antes de comparar contra `match`.
const baseStripped = import.meta.env.BASE_URL.replace(/\/$/, "");
const rawPath = Astro.url.pathname.startsWith(baseStripped)
  ? Astro.url.pathname.slice(baseStripped.length) || "/"
  : Astro.url.pathname;
const currentPath = rawPath.replace(/(.)\/$/, "$1");
const isActive = (match: string[]) =>
  match.some((m) =>
    m === "/" ? currentPath === "/" : currentPath.startsWith(m),
  );
---

<header
  class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/90 pt-[env(safe-area-inset-top)] backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
    aria-label="Principal"
  >
    <a
      href={url("/")}
      class="flex items-center gap-2 text-lg font-bold tracking-tight text-white"
    >
      <span
        class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-emerald-400 to-emerald-600 text-sm font-black text-slate-950 shadow-lg shadow-emerald-500/20"
      >
        FM
      </span>
      <span>
        Fantasy<span class="text-emerald-400">Marca</span>
      </span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.match) ? "page" : undefined}
            class={`flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium transition-colors ${
              isActive(item.match)
                ? "bg-emerald-500/10 text-emerald-400"
                : "text-slate-300 hover:bg-white/5 hover:text-white"
            }`}
          >
            <Icon name={item.icon} />
            {item.label}
          </a>
        ))
      }
    </div>

    <details class="yo-menu relative">
      <summary
        class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-full border border-white/10 py-1 pr-3 pl-1.5 text-sm text-slate-200 hover:bg-white/5 [&::-webkit-details-marker]:hidden"
        aria-label="¿Quién eres?"
      >
        <span
          data-yo-initial
          class="flex h-7 w-7 items-center justify-center rounded-full bg-slate-800 text-xs font-bold text-slate-300"
          >?</span
        >
        <span data-yo-name class="max-w-24 truncate">¿Quién eres?</span>
      </summary>
      <div
        class="absolute right-0 mt-2 w-48 rounded-xl border border-white/10 bg-slate-900 p-2 shadow-xl"
      >
        <p class="px-3 pt-1 pb-2 text-xs text-slate-500">¿Quién eres?</p>
        {
          FAMILIA.map((name) => (
            <button
              type="button"
              data-yo-set={name}
              class="block w-full rounded-lg px-3 py-2.5 text-left text-sm text-slate-200 hover:bg-white/5 data-[active=true]:text-emerald-400"
            >
              {name}
            </button>
          ))
        }
      </div>
    </details>
  </nav>
</header>

<nav
  aria-label="Secciones"
  class="fixed inset-x-0 bottom-0 z-50 border-t border-white/10 bg-slate-950/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md md:hidden"
>
  <ul class="grid grid-cols-5">
    {
      navItems.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.match) ? "page" : undefined}
            class={`flex flex-col items-center gap-1 py-2 text-[11px] font-medium ${
              isActive(item.match) ? "text-emerald-400" : "text-slate-400"
            }`}
          >
            <Icon name={item.icon} class="h-6 w-6" />
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<dialog
  id="yo-onboarding"
  class="m-auto w-[min(22rem,calc(100%-2rem))] rounded-2xl border border-white/10 bg-slate-900 p-6 text-slate-100 shadow-2xl backdrop:bg-black/70"
  aria-labelledby="yo-onboarding-title"
>
  <h2 id="yo-onboarding-title" class="text-xl font-black text-white">
    ¿Quién eres?
  </h2>
  <p class="mt-1 text-sm text-slate-400">
    Así la web te enseña tu clasificación, tu 11 y tus cambios. Se recuerda en
    este móvil.
  </p>
  <div class="mt-5 grid gap-2">
    {
      FAMILIA.map((name) => (
        <button
          type="button"
          data-yo-set={name}
          class="rounded-xl border border-white/10 bg-slate-950/40 px-4 py-3.5 text-left text-base font-semibold text-white hover:border-emerald-500/50"
        >
          {name}
        </button>
      ))
    }
  </div>
  <button
    type="button"
    data-yo-dismiss
    class="mt-4 w-full rounded-xl px-4 py-2 text-sm text-slate-400 hover:text-white"
  >
    Ahora no
  </button>
</dialog>

<script>
  import { FAMILIA, getYo, setYo, YO_EVENT } from "../lib/yo";

  const DISMISS_KEY = "fantasymarca:yo-onboarding-dismissed";
  const menu = document.querySelector<HTMLDetailsElement>(".yo-menu");
  const dialog = document.getElementById("yo-onboarding") as HTMLDialogElement;

  function paint(yo: string | null) {
    const initial = document.querySelector<HTMLElement>("[data-yo-initial]");
    const name = document.querySelector<HTMLElement>("[data-yo-name]");
    if (initial) {
      initial.textContent = yo ? yo.charAt(0) : "?";
      initial.className = yo
        ? "flex h-7 w-7 items-center justify-center rounded-full bg-emerald-500 text-xs font-bold text-slate-950"
        : "flex h-7 w-7 items-center justify-center rounded-full bg-slate-800 text-xs font-bold text-slate-300";
    }
    if (name) name.textContent = yo ?? "¿Quién eres?";
    for (const btn of document.querySelectorAll<HTMLElement>(
      ".yo-menu [data-yo-set]",
    )) {
      btn.dataset.active = String(btn.dataset.yoSet === yo);
    }
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const setBtn = target.closest<HTMLElement>("[data-yo-set]");
    if (setBtn) {
      setYo(FAMILIA.find((f) => f === setBtn.dataset.yoSet) ?? null);
      if (menu) menu.open = false;
      if (dialog.open) dialog.close();
      return;
    }
    if (target.closest("[data-yo-dismiss]")) {
      try {
        sessionStorage.setItem(DISMISS_KEY, "1");
      } catch {
        // sin sessionStorage: se volverá a preguntar en la próxima página
      }
      dialog.close();
      return;
    }
    // Cerrar el menú al tocar fuera.
    if (menu?.open && !menu.contains(target)) menu.open = false;
  });

  window.addEventListener(YO_EVENT, (e) =>
    paint((e as CustomEvent<string | null>).detail),
  );

  // ?yo=Toño en cualquier enlace deja elegido quién eres (útil para pasar
  // un enlace o para la app instalada, que no comparte memoria con Safari).
  const params = new URLSearchParams(location.search);
  const fromUrl = FAMILIA.find((f) => f === params.get("yo"));
  if (params.has("yo")) {
    params.delete("yo");
    const qs = params.toString();
    history.replaceState(
      history.state,
      "",
      `${location.pathname}${qs ? `?${qs}` : ""}${location.hash}`,
    );
    if (fromUrl) setYo(fromUrl);
  }

  const yo = getYo();
  paint(yo);
  let dismissed = false;
  try {
    dismissed = sessionStorage.getItem(DISMISS_KEY) === "1";
  } catch {
    dismissed = false;
  }
  // Cerrar con Escape cuenta como "Ahora no".
  dialog.addEventListener("cancel", () => {
    try {
      sessionStorage.setItem(DISMISS_KEY, "1");
    } catch {
      // sin sessionStorage: se volverá a preguntar en la próxima página
    }
  });
  if (!yo && !dismissed) dialog.showModal();
</script>
