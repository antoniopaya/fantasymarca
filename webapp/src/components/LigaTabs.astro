---
import SubTabs from "./SubTabs.astro";
import { url } from "../lib/data";

interface Props {
  active: "clasificacion" | "estadisticas" | "cara-a-cara";
}

const { active } = Astro.props;
---

<SubTabs
  label="Secciones de la liga"
  active={active}
  tabs={[
    { key: "clasificacion", label: "Clasificación", href: url("/liga") },
    {
      key: "estadisticas",
      label: "Estadísticas",
      href: url("/liga/estadisticas"),
    },
    {
      key: "cara-a-cara",
      label: "Cara a cara",
      href: url("/liga/cara-a-cara"),
    },
  ]}
/>
