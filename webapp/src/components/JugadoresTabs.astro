---
import SubTabs from "./SubTabs.astro";
import { url } from "../lib/data";

interface Props {
  active: "buscar" | "recomendados" | "estadisticas";
}

const { active } = Astro.props;
---

<SubTabs
  label="Secciones de jugadores"
  active={active}
  tabs={[
    { key: "buscar", label: "Buscar", href: url("/jugadores") },
    {
      key: "recomendados",
      label: "Recomendados",
      href: url("/jugadores/recomendados"),
    },
    { key: "estadisticas", label: "Estadísticas", href: url("/estadisticas") },
  ]}
/>
