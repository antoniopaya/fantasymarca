---
import SubTabs from "./SubTabs.astro";
import { url } from "../lib/data";

interface Props {
  active: "buscar" | "recomendados" | "estadisticas" | "desglose";
}

const { active } = Astro.props;
---

<SubTabs
  label="Secciones de jugadores"
  active={active}
  tabs={[
    { key: "buscar", label: "Buscar", href: url("/jugadores"), icon: "search" },
    {
      key: "recomendados",
      label: "Recomendados",
      icon: "sparkles",
      href: url("/jugadores/recomendados"),
    },
    {
      key: "estadisticas",
      label: "Estadísticas",
      href: url("/estadisticas"),
      icon: "chart",
    },
    {
      key: "desglose",
      label: "Puntos por estadística",
      icon: "pie",
      href: url("/jugadores/desglose"),
    },
  ]}
/>
