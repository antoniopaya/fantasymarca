---
import { ICONS, type IconName } from "../lib/icons";

interface Props {
  name: IconName;
  class?: string;
  /** Grosor del trazo; los puntos (more) necesitan más. */
  stroke?: number;
}

const { name, class: className = "h-4 w-4", stroke } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={`shrink-0 ${className}`}
  fill="none"
  stroke="currentColor"
  stroke-width={stroke ?? (name === "more" ? 3 : 1.8)}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={ICONS[name]}></path>
</svg>
