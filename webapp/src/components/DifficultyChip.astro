---
import { DIFFICULTY_COLORS, DIFFICULTY_LABELS } from "../lib/forecast";

interface Props {
  level: number | null;
}

const { level } = Astro.props;
---

{
  level !== null && (
    <span
      class="inline-flex h-[18px] min-w-[18px] items-center justify-center rounded px-1 text-[11px] font-bold text-white"
      style={`background:${DIFFICULTY_COLORS[level]}`}
      title={`Dificultad: ${DIFFICULTY_LABELS[level]}`}
    >
      {level}
    </span>
  )
}
