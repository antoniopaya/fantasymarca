---
interface Props {
  home: string;
  away: string;
  homeLogoUrl: string;
  awayLogoUrl: string;
  dateText: string;
  goalsHome: string | number;
  goalsAway: string | number;
  status: string;
  homeTeamId?: number;
  awayTeamId?: number;
}

const {
  home,
  away,
  homeLogoUrl,
  awayLogoUrl,
  dateText,
  goalsHome,
  goalsAway,
  status,
  homeTeamId,
  awayTeamId,
} = Astro.props;
const isFixture = status === "fixture";
const isLive = status === "playing";
---

<div
  data-match-card
  data-home-team={homeTeamId}
  data-away-team={awayTeamId}
  class={`rounded-xl border p-4 transition-colors ${
    isLive
      ? "border-rose-500/40 bg-rose-500/5"
      : "border-white/10 bg-slate-900/60 hover:border-emerald-500/30"
  }`}
>
  <p
    class={`mb-3 flex items-center justify-center gap-1.5 text-center text-xs font-medium tracking-wide uppercase ${
      isLive ? "text-rose-400" : "text-slate-500"
    }`}
  >
    {
      isLive && (
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-rose-500" />
      )
    }
    {dateText}
  </p>
  <div class="flex items-center justify-between gap-2">
    <div class="flex flex-1 flex-col items-center gap-2 text-center">
      <img
        src={homeLogoUrl}
        alt={home}
        class="h-10 w-10 object-contain"
        loading="lazy"
      />
      <span class="text-sm font-medium text-slate-100">{home}</span>
    </div>

    <div
      class={`shrink-0 rounded-lg px-3 py-1.5 text-center ${isLive ? "bg-rose-500/10" : "bg-slate-800/80"}`}
    >
      {
        isFixture ? (
          <span class="text-xs font-semibold text-slate-400">VS</span>
        ) : (
          <span
            class={`font-mono text-lg font-bold ${isLive ? "text-rose-300" : "text-white"}`}
          >
            {goalsHome} - {goalsAway}
          </span>
        )
      }
    </div>

    <div class="flex flex-1 flex-col items-center gap-2 text-center">
      <img
        src={awayLogoUrl}
        alt={away}
        class="h-10 w-10 object-contain"
        loading="lazy"
      />
      <span class="text-sm font-medium text-slate-100">{away}</span>
    </div>
  </div>
</div>
