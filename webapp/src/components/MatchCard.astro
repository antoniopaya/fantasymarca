---
import { teamLogoUrl } from "../lib/data";

interface Props {
  home: string;
  away: string;
  dateText: string;
  goalsHome: string | number;
  goalsAway: string | number;
  status: string;
  homeTeamId: number;
  awayTeamId: number;
  /** Página del partido (alineaciones probables o puntos), si la hay. */
  href?: string;
}

const {
  home,
  away,
  dateText,
  goalsHome,
  goalsAway,
  status,
  homeTeamId,
  awayTeamId,
  href,
} = Astro.props;
const isFixture = status === "fixture";
const isLive = status === "playing";
const isPostponed = status === "postponed";
const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  data-match-card
  data-home-team={homeTeamId}
  data-away-team={awayTeamId}
  class={`block rounded-xl border px-3 py-2.5 transition-colors ${
    isLive
      ? "border-rose-500/40 bg-rose-500/5"
      : "border-white/10 bg-slate-900/60 hover:border-emerald-500/30"
  }`}
>
  <p
    class={`mb-1.5 flex items-center justify-center gap-1.5 text-center text-[11px] font-medium tracking-wide uppercase ${
      isLive ? "text-rose-400" : "text-slate-500"
    }`}
  >
    {
      isLive && (
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-rose-500" />
      )
    }
    {isPostponed ? "Aplazado" : dateText}
  </p>
  <div class="flex items-center gap-2">
    <div class="flex min-w-0 flex-1 items-center justify-end gap-2 text-right">
      <span class="text-sm leading-tight font-medium text-slate-100"
        >{home}</span
      >
      <img
        src={teamLogoUrl(homeTeamId)}
        alt=""
        class="h-8 w-8 shrink-0 object-contain"
        loading="lazy"
      />
    </div>

    <div
      class={`w-16 shrink-0 rounded-lg py-1 text-center ${isLive ? "bg-rose-500/10" : "bg-slate-800/80"}`}
    >
      {
        isFixture || isPostponed ? (
          <span class="text-xs font-semibold text-slate-400">
            {isPostponed ? "—" : "VS"}
          </span>
        ) : (
          <span
            class={`font-mono text-base font-bold ${isLive ? "text-rose-300" : "text-white"}`}
          >
            {goalsHome}-{goalsAway}
          </span>
        )
      }
    </div>

    <div class="flex min-w-0 flex-1 items-center gap-2">
      <img
        src={teamLogoUrl(awayTeamId)}
        alt=""
        class="h-8 w-8 shrink-0 object-contain"
        loading="lazy"
      />
      <span class="text-sm leading-tight font-medium text-slate-100"
        >{away}</span
      >
    </div>
  </div>
</Tag>
