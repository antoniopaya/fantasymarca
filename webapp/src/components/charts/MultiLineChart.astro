---
interface Series {
  label: string;
  color: string;
  values: (number | null)[];
  /** Línea de referencia (p.ej. la media de la liga): gris, discontinua, sin leyenda de color. */
  reference?: boolean;
}

interface Props {
  title: string;
  xLabels: string[];
  series: Series[];
  /** Para puestos: el 1 arriba. */
  invertY?: boolean;
  valueSuffix?: string;
  /** Eje fijo [mín, máx] en vez de ajustarlo a los datos (p.ej. puestos 1..32). */
  yDomain?: [number, number];
  /** Marcas del eje Y; por defecto, 5 repartidas en el rango. */
  yTicks?: number[];
}

const {
  title,
  xLabels,
  series,
  invertY = false,
  valueSuffix = "",
  yDomain,
  yTicks,
} = Astro.props;

const width = 640;
const height = 260;
const padding = { top: 16, right: 86, bottom: 28, left: 40 };
const plotWidth = width - padding.left - padding.right;
const plotHeight = height - padding.top - padding.bottom;

const all = series.flatMap((s) =>
  s.values.filter((v): v is number => v !== null),
);
let minV = yDomain?.[0] ?? Math.min(...all);
let maxV = yDomain?.[1] ?? Math.max(...all);
if (minV === maxV) {
  minV -= 1;
  maxV += 1;
}
if (!yDomain) {
  const span = maxV - minV;
  minV -= span * 0.05;
  maxV += span * 0.05;
}

const x = (i: number) =>
  padding.left + (i / Math.max(xLabels.length - 1, 1)) * plotWidth;
const y = (v: number) => {
  const t = (v - minV) / (maxV - minV);
  return padding.top + (invertY ? t : 1 - t) * plotHeight;
};

const paths = series.map((s) => {
  let d = "";
  let pen = false;
  s.values.forEach((v, i) => {
    if (v === null) {
      pen = false;
      return;
    }
    d += `${pen ? "L" : "M"} ${x(i).toFixed(1)} ${y(v).toFixed(1)} `;
    pen = true;
  });
  const lastIndex = s.values.findLastIndex((v) => v !== null);
  return {
    ...s,
    d,
    end:
      lastIndex >= 0
        ? { x: x(lastIndex), y: y(s.values[lastIndex] as number) }
        : null,
  };
});

// Etiquetas al final de cada línea, separadas si se pisan.
const endLabels = paths
  .filter((p) => p.end)
  .map((p) => ({
    label: p.label,
    y: (p.end as { y: number }).y,
    x: (p.end as { x: number }).x,
  }))
  .sort((a, b) => a.y - b.y);
for (let i = 1; i < endLabels.length; i++) {
  if (endLabels[i].y - endLabels[i - 1].y < 13) {
    endLabels[i].y = endLabels[i - 1].y + 13;
  }
}

const tickCount = 4;
const ticks = (
  yTicks ??
  Array.from(
    { length: tickCount + 1 },
    (_, i) => minV + ((maxV - minV) * i) / tickCount,
  )
).map((v) => ({ v, y: y(v) }));

const fmt = (v: number) =>
  Number.isInteger(v) ? String(v) : v.toFixed(1).replace(".", ",");

const chartData = {
  xLabels,
  xs: xLabels.map((_, i) => x(i)),
  series: series.map((s) => ({
    label: s.label,
    color: s.reference ? "#94a3b8" : s.color,
    values: s.values,
    ys: s.values.map((v) => (v === null ? null : y(v))),
  })),
  suffix: valueSuffix,
};
---

<figure class="mlc rounded-2xl border border-white/10 bg-slate-900/60 p-4">
  <figcaption class="mb-2 flex flex-wrap items-center justify-between gap-2">
    <span class="text-sm font-semibold text-white">{title}</span>
    <span class="flex flex-wrap gap-3 text-xs text-slate-300">
      {
        series.map((s) => (
          <span class="flex items-center gap-1.5">
            <span
              class="inline-block h-0.5 w-4"
              style={
                s.reference
                  ? "background: repeating-linear-gradient(90deg,#94a3b8 0 4px,transparent 4px 7px)"
                  : `background:${s.color}`
              }
            />
            {s.label}
          </span>
        ))
      }
    </span>
  </figcaption>

  <div class="relative">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      class="h-auto w-full"
      role="img"
      aria-label={title}
      data-chart={JSON.stringify(chartData)}
    >
      {
        ticks.map((t) => (
          <g>
            <line
              x1={padding.left}
              x2={width - padding.right}
              y1={t.y}
              y2={t.y}
              stroke="rgba(255,255,255,0.06)"
            />
            <text
              x={padding.left - 6}
              y={t.y + 3}
              text-anchor="end"
              class="fill-slate-500 text-[10px]"
            >
              {Math.round(t.v)}
            </text>
          </g>
        ))
      }
      {
        xLabels.map((label, i) => (
          <text
            x={x(i)}
            y={height - 8}
            text-anchor="middle"
            class="fill-slate-500 text-[10px]"
          >
            {label}
          </text>
        ))
      }
      {
        paths.map((p) => (
          <path
            d={p.d}
            fill="none"
            stroke={p.reference ? "#94a3b8" : p.color}
            stroke-width="2"
            stroke-linejoin="round"
            stroke-linecap="round"
            stroke-dasharray={p.reference ? "4 3" : undefined}
          />
        ))
      }
      {
        paths.map(
          (p) =>
            p.end && (
              <circle
                cx={p.end.x}
                cy={p.end.y}
                r="4"
                fill={p.reference ? "#94a3b8" : p.color}
                stroke="#0b1222"
                stroke-width="2"
              />
            ),
        )
      }
      {
        endLabels.map((l) => (
          <text x={l.x + 8} y={l.y + 3} class="fill-slate-300 text-[11px]">
            {l.label}
          </text>
        ))
      }
      <line
        data-crosshair
        y1={padding.top}
        y2={height - padding.bottom}
        stroke="rgba(255,255,255,0.25)"
        visibility="hidden"></line>
      <g data-dots></g>
      <rect
        data-hit
        x={padding.left - 10}
        y={padding.top}
        width={plotWidth + 20}
        height={plotHeight}
        fill="transparent"></rect>
    </svg>
    <div
      data-tooltip
      hidden
      class="pointer-events-none absolute top-2 z-10 rounded-lg border border-white/10 bg-slate-950/95 px-3 py-2 text-xs shadow-xl"
    >
    </div>
  </div>

  <details class="mt-2 text-xs text-slate-400">
    <summary class="cursor-pointer select-none">Ver como tabla</summary>
    <div class="mt-2 overflow-x-auto">
      <table class="w-full text-right">
        <thead>
          <tr class="text-slate-500">
            <th class="py-1 text-left font-medium"></th>
            {xLabels.map((l) => <th class="py-1 font-medium">{l}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            series.map((s) => (
              <tr class="border-t border-white/5 text-slate-300">
                <td class="py-1 text-left">{s.label}</td>
                {s.values.map((v) => (
                  <td class="py-1">{v === null ? "—" : fmt(v)}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</figure>

<script>
  interface ChartData {
    xLabels: string[];
    xs: number[];
    series: {
      label: string;
      color: string;
      values: (number | null)[];
      ys: (number | null)[];
    }[];
    suffix: string;
  }

  const fmt = (v: number) =>
    Number.isInteger(v) ? String(v) : v.toFixed(1).replace(".", ",");

  for (const svg of document.querySelectorAll<SVGSVGElement>(
    ".mlc svg[data-chart]",
  )) {
    const data = JSON.parse(svg.dataset.chart ?? "{}") as ChartData;
    const hit = svg.querySelector<SVGRectElement>("[data-hit]");
    const cross = svg.querySelector<SVGLineElement>("[data-crosshair]");
    const dots = svg.querySelector<SVGGElement>("[data-dots]");
    const tooltip =
      svg.parentElement?.querySelector<HTMLElement>("[data-tooltip]");
    if (!hit || !cross || !dots || !tooltip) continue;

    const hide = () => {
      cross.setAttribute("visibility", "hidden");
      dots.innerHTML = "";
      tooltip.hidden = true;
    };

    hit.addEventListener("pointermove", (event) => {
      const pt = svg.createSVGPoint();
      pt.x = event.clientX;
      pt.y = event.clientY;
      const local = pt.matrixTransform(svg.getScreenCTM()?.inverse());
      let i = 0;
      for (let k = 1; k < data.xs.length; k++) {
        if (Math.abs(data.xs[k] - local.x) < Math.abs(data.xs[i] - local.x))
          i = k;
      }
      const cx = data.xs[i];
      cross.setAttribute("x1", String(cx));
      cross.setAttribute("x2", String(cx));
      cross.setAttribute("visibility", "visible");
      dots.innerHTML = data.series
        .filter((s) => s.ys[i] !== null)
        .map(
          (s) =>
            `<circle cx="${cx}" cy="${s.ys[i]}" r="4" fill="${s.color}" stroke="#0b1222" stroke-width="2" />`,
        )
        .join("");
      const rows = data.series
        .filter((s) => s.values[i] !== null)
        .map(
          (s) =>
            `<div class="flex items-center gap-2"><span style="background:${s.color}" class="inline-block h-2 w-2 rounded-full"></span><span class="text-slate-300">${s.label}</span><span class="ml-auto pl-3 font-semibold text-white">${fmt(s.values[i] as number)}${data.suffix}</span></div>`,
        )
        .join("");
      tooltip.innerHTML = `<div class="mb-1 font-semibold text-slate-400">${data.xLabels[i]}</div>${rows}`;
      tooltip.hidden = false;
      const box = svg.getBoundingClientRect();
      const px = (cx / svg.viewBox.baseVal.width) * box.width;
      const left = px > box.width / 2 ? px - tooltip.offsetWidth - 12 : px + 12;
      tooltip.style.left = `${Math.max(0, left)}px`;
    });
    hit.addEventListener("pointerleave", hide);
  }
</script>
