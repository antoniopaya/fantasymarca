---
import MatchCard from "./MatchCard.astro";
import { url } from "../lib/data";
import type { Gameweek, Match } from "../lib/data";

interface Props {
  selected: Gameweek;
  matches: Match[];
  gameweeks: Gameweek[];
  isNext: boolean;
  prevGw?: Gameweek;
  nextGw?: Gameweek;
}

const { selected, matches, gameweeks, isNext, prevGw, nextGw } = Astro.props;

const groups = new Map<string, Match[]>();
for (const match of matches) {
  const dayKey = match.date.text.split(" ").slice(0, 2).join(" ");
  const list = groups.get(dayKey) ?? [];
  list.push(match);
  groups.set(dayKey, list);
}
---

<div class="mb-8 flex flex-wrap items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-2">
      <h1 class="text-3xl font-black text-white">{selected.name}</h1>
      {isNext && (
        <span class="rounded-full bg-emerald-500/15 px-3 py-1 text-xs font-semibold text-emerald-400">Próxima</span>
      )}
    </div>
    <p class="text-sm text-slate-400">Temporada {selected.season}</p>
  </div>
  <div class="flex items-center gap-2">
    <select
      id="jornada-jump"
      aria-label="Ir a jornada"
      class="rounded-full border border-white/10 bg-slate-900/60 px-3 py-2 text-sm text-slate-200 focus:border-emerald-500/50 focus:outline-none"
    >
      {gameweeks.map((gw) => (
        <option value={gw.number} selected={gw.number === selected.number}>
          {gw.name}
        </option>
      ))}
    </select>
    <a
      href={prevGw ? url(`/jornada/${prevGw.number}`) : undefined}
      aria-disabled={!prevGw}
      class={`flex h-9 w-9 items-center justify-center rounded-full border border-white/10 transition-colors ${
        prevGw ? "text-slate-200 hover:bg-white/5" : "pointer-events-none text-slate-700"
      }`}
      aria-label="Jornada anterior"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </a>
    <a
      href={nextGw ? url(`/jornada/${nextGw.number}`) : undefined}
      aria-disabled={!nextGw}
      class={`flex h-9 w-9 items-center justify-center rounded-full border border-white/10 transition-colors ${
        nextGw ? "text-slate-200 hover:bg-white/5" : "pointer-events-none text-slate-700"
      }`}
      aria-label="Jornada siguiente"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>

{
  matches.length === 0 ? (
    <p class="rounded-xl border border-white/10 bg-slate-900/60 p-6 text-center text-slate-400">
      Todavía no hay calendario disponible para esta jornada.
    </p>
  ) : (
    <div class="space-y-8">
      {Array.from(groups.entries()).map(([day, dayMatches]) => (
        <div>
          <h3 class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-500">{day}</h3>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {dayMatches.map((game) => (
              <MatchCard
                home={game.home}
                away={game.away}
                homeLogoUrl={game.homeLogoUrl}
                awayLogoUrl={game.awayLogoUrl}
                dateText={game.date.text}
                goalsHome={game.goals_home}
                goalsAway={game.goals_away}
                status={game.status}
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  )
}

<script>
  const jump = document.getElementById("jornada-jump") as HTMLSelectElement;
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  jump.addEventListener("change", () => {
    window.location.href = `${base}/jornada/${jump.value}`;
  });
</script>
