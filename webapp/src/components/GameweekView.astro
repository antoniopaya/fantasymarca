---
import MatchCard from "./MatchCard.astro";
import { url } from "../lib/data";
import type { Gameweek, Match } from "../lib/data";

interface Props {
  selected: Gameweek;
  matches: Match[];
  gameweeks: Gameweek[];
  isNext: boolean;
  prevGw?: Gameweek;
  nextGw?: Gameweek;
}

const { selected, matches, gameweeks, isNext, prevGw, nextGw } = Astro.props;

// `date.text` no sirve para agrupar por día: para partidos futuros trae la hora
// pegada ("sáb 21:00", así que dos partidos del mismo sábado a horas distintas
// acababan en grupos distintos) y para partidos ya jugados es literalmente
// "Fin". Se agrupa por el `ts` real en huso horario de España, que es donde se
// juega la liga sea cual sea el huso del servidor que hace el build.
const MADRID_TZ = "Europe/Madrid";
const dayKeyFormatter = new Intl.DateTimeFormat("en-CA", {
  timeZone: MADRID_TZ,
});
const dayLabelFormatter = new Intl.DateTimeFormat("es-ES", {
  timeZone: MADRID_TZ,
  weekday: "long",
  day: "numeric",
  month: "long",
});

const sortedMatches = [...matches].sort((a, b) => a.date.ts - b.date.ts);

// Cuenta atrás al primer partido sin empezar de esta jornada, solo tiene
// sentido en la página de "próxima jornada".
const firstKickoffTs = isNext
  ? (sortedMatches.find((m) => m.status === "fixture")?.date.ts ?? null)
  : null;

const groups = new Map<string, { label: string; matches: Match[] }>();
for (const match of sortedMatches) {
  const date = new Date(match.date.ts * 1000);
  const dayKey = dayKeyFormatter.format(date);
  const existing = groups.get(dayKey);
  if (existing) {
    existing.matches.push(match);
  } else {
    groups.set(dayKey, {
      label: dayLabelFormatter.format(date),
      matches: [match],
    });
  }
}
---

<div class="mb-8 flex flex-wrap items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-2">
      <h1 class="text-3xl font-black text-white">{selected.name}</h1>
      {
        isNext && (
          <span class="rounded-full bg-emerald-500/15 px-3 py-1 text-xs font-semibold text-emerald-400">
            Próxima
          </span>
        )
      }
    </div>
    <p class="text-sm text-slate-400">Temporada {selected.season}</p>
    {
      firstKickoffTs !== null && (
        <p
          id="kickoff-countdown"
          data-kickoff-ts={firstKickoffTs}
          class="mt-1 text-sm font-medium text-emerald-400"
        />
      )
    }
  </div>
  <div class="flex items-center gap-2">
    <select
      id="jornada-jump"
      aria-label="Ir a jornada"
      class="rounded-full border border-white/10 bg-slate-900/60 px-3 py-2 text-sm text-slate-200 focus:border-emerald-500/50 focus:outline-none"
    >
      {
        gameweeks.map((gw) => (
          <option value={gw.number} selected={gw.number === selected.number}>
            {gw.name}
          </option>
        ))
      }
    </select>
    <a
      href={prevGw ? url(`/jornada/${prevGw.number}`) : undefined}
      aria-disabled={!prevGw}
      class={`flex h-9 w-9 items-center justify-center rounded-full border border-white/10 transition-colors ${
        prevGw
          ? "text-slate-200 hover:bg-white/5"
          : "pointer-events-none text-slate-700"
      }`}
      aria-label="Jornada anterior"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"
        ></path>
      </svg>
    </a>
    <a
      href={nextGw ? url(`/jornada/${nextGw.number}`) : undefined}
      aria-disabled={!nextGw}
      class={`flex h-9 w-9 items-center justify-center rounded-full border border-white/10 transition-colors ${
        nextGw
          ? "text-slate-200 hover:bg-white/5"
          : "pointer-events-none text-slate-700"
      }`}
      aria-label="Jornada siguiente"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
        ></path>
      </svg>
    </a>
  </div>
</div>

{
  matches.length === 0 ? (
    <p class="rounded-xl border border-white/10 bg-slate-900/60 p-6 text-center text-slate-400">
      Todavía no hay calendario disponible para esta jornada.
    </p>
  ) : (
    <div class="space-y-8">
      {Array.from(groups.values()).map(({ label, matches: dayMatches }) => (
        <div>
          <h3 class="mb-3 text-xs font-semibold tracking-wide text-slate-500 uppercase">
            {label}
          </h3>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {dayMatches.map((game) => (
              <MatchCard
                home={game.home}
                away={game.away}
                homeLogoUrl={game.homeLogoUrl}
                awayLogoUrl={game.awayLogoUrl}
                dateText={game.date.text}
                goalsHome={game.goals_home}
                goalsAway={game.goals_away}
                status={game.status}
                homeTeamId={game.id_home}
                awayTeamId={game.id_away}
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  )
}

<script>
  const jump = document.getElementById("jornada-jump") as HTMLSelectElement;
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  jump.addEventListener("change", () => {
    window.location.href = `${base}/jornada/${jump.value}`;
  });

  const countdownEl = document.getElementById("kickoff-countdown");
  if (countdownEl) {
    const kickoffMs = Number(countdownEl.dataset.kickoffTs) * 1000;

    const updateCountdown = () => {
      const diff = kickoffMs - Date.now();
      if (diff <= 0) {
        countdownEl.textContent = "El primer partido ya ha empezado";
        clearInterval(interval);
        return;
      }
      const totalSeconds = Math.floor(diff / 1000);
      const days = Math.floor(totalSeconds / 86_400);
      const hours = Math.floor((totalSeconds % 86_400) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;
      const parts =
        days > 0
          ? [`${days}d`, `${hours}h`]
          : [`${hours}h`, `${minutes}m`, `${seconds}s`];
      countdownEl.textContent = `Empieza en ${parts.join(" ")}`;
    };

    updateCountdown();
    const interval = setInterval(updateCountdown, 1000);
  }

  // Resalta los partidos en los que juega algún equipo de la convocatoria
  // activa de "Crear once" (mismo localStorage, ver crear-once.astro). Si no
  // hay ninguna convocatoria guardada o localStorage no está disponible, no
  // se resalta nada.
  function getMyTeamIds(): Set<number> {
    try {
      const activeId = localStorage.getItem("fantasymarca:crear-once:active");
      const raw = localStorage.getItem("fantasymarca:crear-once:lineups");
      if (!activeId || !raw) return new Set();
      const lineups = JSON.parse(raw);
      const teamIds = lineups[activeId]?.teamIds;
      return new Set(Array.isArray(teamIds) ? teamIds : []);
    } catch {
      return new Set();
    }
  }

  const myTeamIds = getMyTeamIds();
  if (myTeamIds.size > 0) {
    document
      .querySelectorAll<HTMLElement>("[data-match-card]")
      .forEach((card) => {
        const home = Number(card.dataset.homeTeam);
        const away = Number(card.dataset.awayTeam);
        if (myTeamIds.has(home) || myTeamIds.has(away)) {
          card.classList.add("ring-2", "ring-emerald-500/50");
          card.title = "Juega uno de los equipos de tu once";
        }
      });
  }
</script>
