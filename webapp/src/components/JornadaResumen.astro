---
// Resumen de una jornada ya jugada: tu jornada en la liga, los que más
// puntuaron y el 11 ideal. Se pinta encima de los partidos en /jornada/N.
import {
  getAllPlayerSummaries,
  getGameweekPoints,
  getLigaJornadas,
  playerPhotoUrl,
  POSITION_SHORT,
  url,
} from "../lib/data";
import { idealEleven } from "../lib/liga";
import { FAMILIA } from "../lib/yo";

interface Props {
  number: number;
}

const { number } = Astro.props;

const top = getAllPlayerSummaries()
  .map((s) => ({ s, points: getGameweekPoints(s.id, number) }))
  .filter((r): r is { s: typeof r.s; points: number } => r.points !== null)
  .sort((a, b) => b.points - a.points)
  .slice(0, 8);

const ideal = idealEleven(number);

const jornada = getLigaJornadas().find((j) => j.number === number);
const bestPoints = jornada
  ? Math.max(...jornada.entries.map((e) => e.points))
  : 0;
const winners =
  jornada?.entries
    .filter((e) => e.points === bestPoints)
    .map((e) => e.participant) ?? [];
const familia = FAMILIA.map((name) => {
  const entry = jornada?.entries.find((e) => e.participant === name);
  if (!jornada || !entry) return null;
  return {
    name,
    entry,
    rank: 1 + jornada.entries.filter((e) => e.points > entry.points).length,
    players: [...entry.players].sort((a, b) => b.points - a.points),
  };
}).filter((f) => f !== null);
const participants = jornada?.entries.length ?? 0;
---

{
  (top.length > 0 || familia.length > 0) && (
    <section
      class="mb-8 space-y-4"
      aria-label={`Resumen de la Jornada ${number}`}
    >
      {familia.map((f) => (
        <div
          data-yo-panel={f.name}
          hidden
          class="rounded-2xl border border-emerald-500/20 bg-emerald-500/5 p-4"
        >
          <div class="flex items-baseline justify-between gap-3">
            <h2 class="text-sm font-semibold text-white">
              Tu Jornada {number}
            </h2>
            <p class="text-2xl font-black text-white">
              {f.entry.points}
              <span class="ml-1 text-sm font-medium text-slate-400">pts</span>
            </p>
          </div>
          <p class="mt-0.5 text-sm text-slate-400">
            {f.rank}º de {participants} en la jornada · ganó{" "}
            {winners.join(" y ")} con {bestPoints}
          </p>
          <details class="mt-2">
            <summary class="cursor-pointer py-1 text-sm font-medium text-emerald-400">
              Tus 11 jugador a jugador
            </summary>
            <ul class="mt-2 grid grid-cols-1 gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
              {f.players.map((p) => (
                <li class="flex items-center justify-between gap-2 text-slate-300">
                  <span class="min-w-0 truncate">
                    {p.id !== null ? (
                      <a
                        href={url(`/jugadores/${p.id}`)}
                        class="hover:text-emerald-400"
                      >
                        {p.name}
                      </a>
                    ) : (
                      p.name
                    )}
                    {p.captain && (
                      <span class="ml-1 rounded bg-amber-400 px-1 text-[11px] font-bold text-slate-950">
                        C
                      </span>
                    )}
                  </span>
                  <span class="shrink-0 tabular-nums">
                    {p.captain ? p.points * 2 : p.points}
                  </span>
                </li>
              ))}
            </ul>
          </details>
        </div>
      ))}

      {top.length > 0 && (
        <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4">
          <h2 class="mb-3 text-sm font-semibold text-white">
            Los que más puntuaron
          </h2>
          <ol class="-mx-1 flex snap-x [scrollbar-width:none] gap-2 overflow-x-auto px-1 pb-1">
            {top.map((r) => (
              <li class="shrink-0 snap-start">
                <a
                  href={url(`/jugadores/${r.s.id}`)}
                  class="flex w-24 flex-col items-center rounded-xl border border-white/10 bg-slate-950/40 px-1 py-2 text-center hover:border-emerald-500/40"
                >
                  <img
                    src={playerPhotoUrl(r.s.id)}
                    alt=""
                    loading="lazy"
                    class="h-11 w-11 rounded-full bg-slate-800 object-cover"
                  />
                  <span class="mt-1 block w-full truncate text-xs font-semibold text-white">
                    {r.s.name.split(" ").slice(-1)[0]}
                  </span>
                  <span class="block w-full truncate text-[11px] text-slate-500">
                    {r.s.team_name}
                  </span>
                  <span class="text-sm font-bold text-emerald-300">
                    {r.points} pts
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      )}

      {ideal && (
        <details class="rounded-2xl border border-white/10 bg-slate-900/60 p-4">
          <summary class="cursor-pointer text-sm font-semibold text-white">
            11 ideal: {ideal.points} pts
            <span class="font-normal text-slate-400">
              {" "}
              ({ideal.formationKey}, {ideal.cost / 1_000_000}M
              {jornada && `; el mejor de la liga hizo ${bestPoints}`})
            </span>
          </summary>
          <ul class="mt-3 grid grid-cols-1 gap-1.5 text-sm sm:grid-cols-2">
            {ideal.players.map((p) => (
              <li class="flex items-center gap-2 text-slate-300">
                <span class="w-8 shrink-0 text-[11px] font-semibold text-slate-500">
                  {POSITION_SHORT[p.summary.position]}
                </span>
                <a
                  href={url(`/jugadores/${p.summary.id}`)}
                  class="min-w-0 flex-1 truncate hover:text-emerald-400"
                >
                  {p.summary.name}
                  {p.captain && (
                    <span class="ml-1 rounded bg-amber-400 px-1 text-[11px] font-bold text-slate-950">
                      C
                    </span>
                  )}
                </a>
                <span class="shrink-0 text-slate-400 tabular-nums">
                  {p.captain ? p.points * 2 : p.points} pts
                </span>
              </li>
            ))}
          </ul>
        </details>
      )}
    </section>
  )
}
