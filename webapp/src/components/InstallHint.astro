---
// Invitación a instalar la web como app. No sale si ya está instalada o si
// se ha cerrado antes. En Android/Chrome se usa el aviso nativo
// (beforeinstallprompt); en iPhone no existe, así que se explica a mano.
---

<div
  id="install-hint"
  hidden
  class="flex items-start gap-3 rounded-2xl border border-white/10 bg-slate-900/60 p-4 text-sm text-slate-300"
>
  <img
    src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/icons/icon-192.png`}
    alt=""
    class="h-10 w-10 shrink-0 rounded-xl"
  />
  <div class="min-w-0 flex-1">
    <p class="font-semibold text-white">Instálala como app</p>
    <p id="install-ios" hidden class="mt-0.5">
      En Safari, pulsa <b>Compartir</b> y luego
      <b>Añadir a pantalla de inicio</b>. Ojo: en la app tendrás que volver a
      elegir quién eres.
    </p>
    <p id="install-other" hidden class="mt-0.5">
      Se abre a pantalla completa y funciona sin conexión.
    </p>
    <button
      type="button"
      id="install-btn"
      hidden
      class="mt-2 rounded-full bg-emerald-500 px-4 py-1.5 font-semibold text-slate-950"
    >
      Instalar
    </button>
  </div>
  <button
    type="button"
    id="install-close"
    aria-label="No mostrar más"
    class="-m-1 shrink-0 rounded-full p-1 text-slate-500 hover:text-white"
  >
    ✕
  </button>
</div>

<script>
  const KEY = "fantasymarca:install-hint-closed";
  const box = document.getElementById("install-hint");
  const standalone =
    window.matchMedia("(display-mode: standalone)").matches ||
    (navigator as Navigator & { standalone?: boolean }).standalone === true;
  let closed = false;
  try {
    closed = localStorage.getItem(KEY) === "1";
  } catch {
    closed = false;
  }

  if (box && !standalone && !closed) {
    const ios = /iphone|ipad|ipod/i.test(navigator.userAgent);
    if (ios) {
      box.hidden = false;
      document.getElementById("install-ios")!.hidden = false;
    }
    window.addEventListener("beforeinstallprompt", (event) => {
      event.preventDefault();
      const prompt = event as Event & { prompt: () => Promise<void> };
      box.hidden = false;
      document.getElementById("install-other")!.hidden = false;
      const btn = document.getElementById("install-btn")!;
      btn.hidden = false;
      btn.addEventListener(
        "click",
        async () => {
          await prompt.prompt();
          box.hidden = true;
        },
        { once: true },
      );
    });
    document.getElementById("install-close")?.addEventListener("click", () => {
      box.hidden = true;
      try {
        localStorage.setItem(KEY, "1");
      } catch {
        // sin localStorage: volverá a salir la próxima vez
      }
    });
  }
</script>
