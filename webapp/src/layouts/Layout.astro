---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { url } from "../lib/data";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = "Panel de Fantasy Marca: jornadas, jugadores y estadísticas.",
} = Astro.props;
const fullTitle = title ? `${title} · FantasyMarca` : "FantasyMarca";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-emerald-500 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-slate-950"
    >
      Saltar al contenido
    </a>
    <div class="bg-grid pointer-events-none fixed inset-0 -z-10"></div>
    <Navbar />
    <main id="main-content" class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
      <slot />
    </main>
    <Footer />
    <script>
      // Todas las fotos de jugador/escudo salen del CDN de fantasy.marca.com:
      // si un jugador nuevo o un escudo todavía no está dado de alta ahí, la
      // imagen rompe. En vez de repetir un onerror en cada <img> (y arrastrar
      // el aviso de accesibilidad de "listener en elemento no interactivo"),
      // un único listener delegado en document cubre cualquier imagen de la
      // página. `error` no burbujea, así que hace falta la fase de captura.
      document.addEventListener(
        "error",
        (event) => {
          if (event.target instanceof HTMLImageElement) {
            event.target.style.opacity = "0";
          }
        },
        true,
      );
    </script>
  </body>
</html>
